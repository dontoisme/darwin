#!/bin/bash
#
# darwin-status
#
# Show current darwin state: captures, pending changes, hook status.
#
# Usage:
#   darwin status
#

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
LIB_DIR="$SCRIPT_DIR/../lib"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
DIM='\033[2m'
NC='\033[0m'

# Source configuration
if [ -f "$LIB_DIR/config.sh" ]; then
    source "$LIB_DIR/config.sh"
fi

echo ""
echo -e "${GREEN}🧬 Darwin Status${NC}"
echo ""

# Check if darwin is initialized
if ! load_config 2>/dev/null; then
    echo -e "${YELLOW}Not initialized${NC}"
    echo ""
    echo "Darwin hasn't been set up in this project."
    echo ""
    echo -e "${CYAN}Get started:${NC}"
    echo "  darwin init                 # Initialize darwin"
    echo ""
    exit 0
fi

# Show project info
echo -e "${BLUE}Project${NC}"
echo "  Config:     darwin.json"
echo "  Project:    $CONFIG_PROJECT"
echo "  Scheme:     $CONFIG_SCHEME"
echo ""

# Check captures
INDEX_FILE="$CONFIG_OUTPUT_PATH/index.json"
CAPTURES_DIR="$CONFIG_OUTPUT_PATH/captures"

if [ -f "$INDEX_FILE" ]; then
    CAPTURE_COUNT=$(jq '.captures | length' "$INDEX_FILE" 2>/dev/null || echo "0")
    LATEST_CAPTURE=$(jq -r '.captures | last | .id // "none"' "$INDEX_FILE" 2>/dev/null)
    LATEST_COMMIT=$(jq -r '.captures | last | .commit // "none"' "$INDEX_FILE" 2>/dev/null)
    LATEST_DATE=$(jq -r '.captures | last | .timestamp // "none"' "$INDEX_FILE" 2>/dev/null)

    echo -e "${BLUE}Timeline${NC}"
    echo "  Captures:   $CAPTURE_COUNT"

    if [ "$CAPTURE_COUNT" -gt 0 ]; then
        echo "  Latest:     $LATEST_CAPTURE ($LATEST_COMMIT)"
        if [ "$LATEST_DATE" != "none" ]; then
            # Format date nicely
            FORMATTED_DATE=$(date -j -f "%Y-%m-%dT%H:%M:%SZ" "$LATEST_DATE" "+%b %d, %Y %H:%M" 2>/dev/null || echo "$LATEST_DATE")
            echo "  Date:       $FORMATTED_DATE"
        fi
    fi
    echo ""
else
    echo -e "${BLUE}Timeline${NC}"
    echo -e "  ${YELLOW}No captures yet${NC}"
    echo ""
fi

# Check for pending changes (Swift files changed since last capture)
if [ "$CAPTURE_COUNT" -gt 0 ] && [ "$LATEST_COMMIT" != "none" ]; then
    CURRENT_COMMIT=$(git rev-parse --short HEAD 2>/dev/null || echo "")

    if [ -n "$CURRENT_COMMIT" ] && [ "$CURRENT_COMMIT" != "$LATEST_COMMIT" ]; then
        CHANGED_FILES=$(git diff --name-only "$LATEST_COMMIT" HEAD -- '*.swift' 2>/dev/null | wc -l | tr -d ' ')

        if [ "$CHANGED_FILES" -gt 0 ]; then
            echo -e "${BLUE}Pending Changes${NC}"
            echo -e "  ${YELLOW}$CHANGED_FILES Swift files changed since last capture${NC}"
            echo "  Current:    $CURRENT_COMMIT"
            echo "  Captured:   $LATEST_COMMIT"
            echo ""

            # Show affected screens
            if [ -f "$CONFIG_MANIFEST_PATH" ]; then
                CHANGED_SWIFT=$(git diff --name-only "$LATEST_COMMIT" HEAD -- '*.swift' 2>/dev/null)
                AFFECTED_COUNT=0

                while IFS= read -r screen_id; do
                    SOURCES=$(jq -r ".screens[\"$screen_id\"].sources[]" "$CONFIG_MANIFEST_PATH" 2>/dev/null)
                    for source in $SOURCES; do
                        if echo "$CHANGED_SWIFT" | grep -q "$source"; then
                            if [ "$AFFECTED_COUNT" -eq 0 ]; then
                                echo -e "${BLUE}Affected Screens${NC}"
                            fi
                            SCREEN_NAME=$(jq -r ".screens[\"$screen_id\"].name" "$CONFIG_MANIFEST_PATH" 2>/dev/null)
                            echo "  - $SCREEN_NAME ($screen_id)"
                            AFFECTED_COUNT=$((AFFECTED_COUNT + 1))
                            break
                        fi
                    done
                done < <(jq -r '.screens | keys[]' "$CONFIG_MANIFEST_PATH" 2>/dev/null)

                if [ "$AFFECTED_COUNT" -gt 0 ]; then
                    echo ""
                fi
            fi
        else
            echo -e "${BLUE}Changes${NC}"
            echo -e "  ${GREEN}No Swift changes since last capture${NC}"
            echo ""
        fi
    else
        echo -e "${BLUE}Changes${NC}"
        echo -e "  ${GREEN}Up to date${NC}"
        echo ""
    fi
fi

# Check git hook status
GIT_DIR="$(pwd)/.git"
POST_COMMIT_HOOK="$GIT_DIR/hooks/post-commit"

echo -e "${BLUE}Git Hook${NC}"
if [ -f "$POST_COMMIT_HOOK" ] && grep -q "darwin-hook-managed" "$POST_COMMIT_HOOK" 2>/dev/null; then
    if grep -q "darwin capture 2>&1" "$POST_COMMIT_HOOK" 2>/dev/null; then
        echo -e "  ${GREEN}Installed (auto-capture)${NC}"
    else
        echo -e "  ${GREEN}Installed (prompt mode)${NC}"
    fi
else
    echo -e "  ${DIM}Not installed${NC}"
    echo "  Run: darwin hook install"
fi
echo ""

# Suggested next action
echo -e "${CYAN}Suggested next action:${NC}"
if [ "$CAPTURE_COUNT" -eq 0 ]; then
    echo "  darwin capture --baseline   # Create your first baseline"
elif [ -n "$CHANGED_FILES" ] && [ "$CHANGED_FILES" -gt 0 ]; then
    echo "  darwin capture              # Capture pending changes"
else
    echo "  darwin viewer               # View your timeline"
fi
echo ""
