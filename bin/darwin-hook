#!/bin/bash
#
# darwin-hook
#
# Install/manage git hooks for automatic darwin captures.
#
# Usage:
#   darwin hook install       # Install post-commit hook
#   darwin hook uninstall     # Remove hook
#   darwin hook status        # Check if hook is installed
#

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
LIB_DIR="$SCRIPT_DIR/../lib"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

# Source configuration (optional)
if [ -f "$LIB_DIR/config.sh" ]; then
    source "$LIB_DIR/config.sh"
fi

# Try to load config
if load_config 2>/dev/null; then
    GIT_DIR="$PROJECT_DIR/.git"
else
    GIT_DIR="$(pwd)/.git"
fi

HOOKS_DIR="$GIT_DIR/hooks"
POST_COMMIT_HOOK="$HOOKS_DIR/post-commit"

# Hook content
HOOK_MARKER="# darwin-hook-managed"
HOOK_CONTENT='#!/bin/bash
# darwin-hook-managed
# Auto-capture screenshots after commit (if darwin.json exists)

if [ -f "darwin.json" ]; then
    # Only run if there are Swift file changes in this commit
    CHANGED_SWIFT=$(git diff-tree --no-commit-id --name-only -r HEAD -- "*.swift" 2>/dev/null | head -1)

    if [ -n "$CHANGED_SWIFT" ]; then
        echo ""
        echo "🧬 Darwin: Swift files changed, triggering smart capture..."
        echo ""

        # Run capture in background to not block commit
        if command -v darwin &> /dev/null; then
            darwin capture --dry-run 2>/dev/null

            # Show what would be captured
            echo ""
            echo "Run '\''darwin capture'\'' to capture these changes."

            # Check for new views not yet in manifest
            if ! darwin detect --check 2>/dev/null; then
                echo ""
                echo "🔍 New SwiftUI views detected:"
                darwin detect 2>/dev/null
                echo ""
                read -p "Add to manifest and generate test stubs? [Y/n] " response
                case "$response" in
                    [Nn]* ) echo "Skipped." ;;
                    * ) darwin detect --add --yes 2>/dev/null ;;
                esac
            fi
        fi
    fi
fi
'

HOOK_CONTENT_AUTO='#!/bin/bash
# darwin-hook-managed
# Auto-capture screenshots after commit (if darwin.json exists)

if [ -f "darwin.json" ]; then
    # Only run if there are Swift file changes in this commit
    CHANGED_SWIFT=$(git diff-tree --no-commit-id --name-only -r HEAD -- "*.swift" 2>/dev/null | head -1)

    if [ -n "$CHANGED_SWIFT" ]; then
        echo ""
        echo "🧬 Darwin: Swift files changed, running smart capture..."
        echo ""

        if command -v darwin &> /dev/null; then
            # Check for new views first and auto-add them
            if ! darwin detect --check 2>/dev/null; then
                echo "🔍 New SwiftUI views detected, adding to manifest..."
                darwin detect --add --yes 2>/dev/null
                echo ""
            fi

            # Run capture
            darwin capture 2>&1 | tail -20
        fi
    fi
fi
'

print_usage() {
    echo -e "${GREEN}🧬 Darwin - Git Hook Manager${NC}"
    echo ""
    echo "Usage: darwin hook <command> [options]"
    echo ""
    echo "Commands:"
    echo "  install     Install post-commit hook"
    echo "  uninstall   Remove darwin hook"
    echo "  status      Check if hook is installed"
    echo ""
    echo "Options:"
    echo "  --auto      Auto-capture and auto-add new views (default: prompt)"
    echo "  --help      Show this help"
    echo ""
    echo "Examples:"
    echo "  darwin hook install           # Install hook (prompts for capture + new views)"
    echo "  darwin hook install --auto    # Install hook (auto-captures + auto-adds views)"
    echo "  darwin hook uninstall         # Remove hook"
    echo ""
    echo "After commit with Swift changes, the hook will:"
    echo "  1. Detect new SwiftUI views not in manifest"
    echo "  2. Prompt to add them (or auto-add in --auto mode)"
    echo "  3. Run smart capture for affected screens"
}

check_git_repo() {
    if [ ! -d "$GIT_DIR" ]; then
        echo -e "${RED}Error: Not a git repository${NC}"
        exit 1
    fi
}

is_hook_installed() {
    if [ -f "$POST_COMMIT_HOOK" ] && grep -q "$HOOK_MARKER" "$POST_COMMIT_HOOK" 2>/dev/null; then
        return 0
    fi
    return 1
}

install_hook() {
    local auto_mode=false

    # Parse options
    for arg in "$@"; do
        case "$arg" in
            --auto)
                auto_mode=true
                ;;
        esac
    done

    check_git_repo
    mkdir -p "$HOOKS_DIR"

    if is_hook_installed; then
        echo -e "${YELLOW}Darwin hook is already installed.${NC}"
        echo "Run 'darwin hook uninstall' first to reinstall."
        exit 0
    fi

    # Check if post-commit hook already exists
    if [ -f "$POST_COMMIT_HOOK" ]; then
        echo -e "${YELLOW}Warning: post-commit hook already exists.${NC}"
        echo "Current hook will be backed up to post-commit.backup"
        cp "$POST_COMMIT_HOOK" "${POST_COMMIT_HOOK}.backup"

        # Append darwin hook to existing hook
        if [ "$auto_mode" = true ]; then
            echo "$HOOK_CONTENT_AUTO" >> "$POST_COMMIT_HOOK"
        else
            echo "$HOOK_CONTENT" >> "$POST_COMMIT_HOOK"
        fi
    else
        # Create new hook
        if [ "$auto_mode" = true ]; then
            echo "$HOOK_CONTENT_AUTO" > "$POST_COMMIT_HOOK"
        else
            echo "$HOOK_CONTENT" > "$POST_COMMIT_HOOK"
        fi
    fi

    chmod +x "$POST_COMMIT_HOOK"

    echo -e "${GREEN}=== Darwin Hook Installed ===${NC}"
    echo ""
    echo "Location: $POST_COMMIT_HOOK"
    if [ "$auto_mode" = true ]; then
        echo "Mode: Auto-capture (will run 'darwin capture' after commits)"
    else
        echo "Mode: Prompt (will show affected screens after commits)"
    fi
    echo ""
    echo -e "${CYAN}What happens now:${NC}"
    echo "  After each commit with Swift changes, darwin will:"
    if [ "$auto_mode" = true ]; then
        echo "    - Auto-detect and add new SwiftUI views to manifest"
        echo "    - Automatically run smart capture"
        echo "    - Add new screenshots to your timeline"
    else
        echo "    - Detect new SwiftUI views and prompt to add them"
        echo "    - Show which screens would be affected"
        echo "    - Prompt you to run 'darwin capture'"
    fi
    echo ""
    echo -e "${GREEN}🧬 Hook ready!${NC}"
}

uninstall_hook() {
    check_git_repo

    if ! is_hook_installed; then
        echo -e "${YELLOW}Darwin hook is not installed.${NC}"
        exit 0
    fi

    # Check if hook has other content
    local other_content=$(grep -v "$HOOK_MARKER" "$POST_COMMIT_HOOK" | grep -v "^#!" | grep -v "^$" | grep -v "darwin" | head -1)

    if [ -n "$other_content" ]; then
        # Hook has other content - just remove darwin section
        echo -e "${YELLOW}Hook has other content. Removing only darwin section.${NC}"
        # Create temp file without darwin section
        sed "/$HOOK_MARKER/,/^fi$/d" "$POST_COMMIT_HOOK" > "${POST_COMMIT_HOOK}.tmp"
        mv "${POST_COMMIT_HOOK}.tmp" "$POST_COMMIT_HOOK"
    else
        # Hook is darwin-only - remove it
        rm "$POST_COMMIT_HOOK"
    fi

    echo -e "${GREEN}Darwin hook removed.${NC}"

    # Restore backup if exists
    if [ -f "${POST_COMMIT_HOOK}.backup" ]; then
        echo "Backup available at: ${POST_COMMIT_HOOK}.backup"
    fi
}

show_status() {
    check_git_repo

    echo -e "${GREEN}🧬 Darwin Hook Status${NC}"
    echo ""

    if is_hook_installed; then
        echo -e "Status: ${GREEN}Installed${NC}"
        echo "Location: $POST_COMMIT_HOOK"

        if grep -q "darwin capture 2>&1" "$POST_COMMIT_HOOK" 2>/dev/null; then
            echo "Mode: Auto-capture"
        else
            echo "Mode: Prompt"
        fi
    else
        echo -e "Status: ${YELLOW}Not installed${NC}"
        echo ""
        echo "Install with: darwin hook install"
    fi
}

# Main command handler
case "${1:-}" in
    install)
        shift
        install_hook "$@"
        ;;
    uninstall|remove)
        uninstall_hook
        ;;
    status)
        show_status
        ;;
    --help|-h|help|"")
        print_usage
        ;;
    *)
        echo -e "${RED}Unknown command: $1${NC}"
        echo ""
        print_usage
        exit 1
        ;;
esac
