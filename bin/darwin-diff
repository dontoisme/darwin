#!/bin/bash
#
# darwin-diff
#
# Compare screenshots between two captures and generate a visual diff report.
# Uses ImageMagick for pixel-based comparison.
#
# Usage:
#   darwin diff                         # Compare latest vs parent
#   darwin diff <capture1> <capture2>   # Compare two specific captures
#   darwin diff --html                  # Generate HTML report
#

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
LIB_DIR="$SCRIPT_DIR/../lib"

# Source configuration (optional for diff)
if [ -f "$LIB_DIR/config.sh" ]; then
    source "$LIB_DIR/config.sh"
fi

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

# Thresholds
DIFF_THRESHOLD=0.01  # Percent difference to consider "changed"
SIGNIFICANT_THRESHOLD=5  # Percent difference to highlight as significant
FUZZ_TOLERANCE=5  # Percent color difference to ignore (helps with time/battery changes)

# Try to load config, but fall back to current directory
if load_config 2>/dev/null; then
    SCREENSHOT_DIR="$CONFIG_OUTPUT_PATH"
else
    # Fall back to Screenshots directory in current directory
    SCREENSHOT_DIR="$(pwd)/Screenshots"
    PROJECT_DIR="$(pwd)"
fi

# New structure paths
CAPTURES_DIR="$SCREENSHOT_DIR/captures"
INDEX_FILE="$SCREENSHOT_DIR/index.json"
DIFFS_DIR="$SCREENSHOT_DIR/diffs"

echo -e "${BLUE}🧬 Darwin - Screenshot Diff${NC}"
echo ""

# Parse arguments
GENERATE_HTML=false
CAPTURE1=""
CAPTURE2=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --html)
            GENERATE_HTML=true
            shift
            ;;
        --threshold)
            DIFF_THRESHOLD="$2"
            shift 2
            ;;
        --fuzz)
            FUZZ_TOLERANCE="$2"
            shift 2
            ;;
        --help|-h)
            echo "Usage: darwin diff [OPTIONS] [capture1] [capture2]"
            echo ""
            echo "Options:"
            echo "  --html          Generate HTML report with visual diffs"
            echo "  --threshold N   Percent difference threshold (default: 0.01)"
            echo "  --fuzz N        Color fuzz tolerance percent (default: 5)"
            echo "                  Helps ignore time/battery changes"
            echo "  --help          Show this help"
            echo ""
            echo "Arguments:"
            echo "  capture1   First capture ID (default: parent of latest)"
            echo "  capture2   Second capture ID (default: latest)"
            echo ""
            echo "Examples:"
            echo "  darwin diff                           # Compare latest vs its parent"
            echo "  darwin diff baseline abc1234          # Compare baseline to specific capture"
            echo "  darwin diff baseline abc1234 --html   # Generate HTML report"
            echo ""
            echo "Available captures:"
            if [ -f "$INDEX_FILE" ]; then
                jq -r '.captures[] | "  \(.id) (\(.commit)) - \(.timestamp)"' "$INDEX_FILE" 2>/dev/null || echo "  (none)"
            else
                echo "  (no index.json found)"
            fi
            exit 0
            ;;
        *)
            if [ -z "$CAPTURE1" ]; then
                CAPTURE1="$1"
            elif [ -z "$CAPTURE2" ]; then
                CAPTURE2="$1"
            fi
            shift
            ;;
    esac
done

# Check for ImageMagick
if ! command -v compare &> /dev/null; then
    echo -e "${YELLOW}Warning: ImageMagick not found. Install with: brew install imagemagick${NC}"
    echo "Falling back to file size comparison only."
    USE_IMAGEMAGICK=false
else
    USE_IMAGEMAGICK=true
fi

# Helper to get capture info from index
get_capture_parent() {
    local capture_id="$1"
    if [ -f "$INDEX_FILE" ]; then
        jq -r ".captures[] | select(.id == \"$capture_id\") | .parent // empty" "$INDEX_FILE" 2>/dev/null
    fi
}

get_latest_capture() {
    if [ -f "$INDEX_FILE" ]; then
        jq -r '.captures | last | .id // empty' "$INDEX_FILE" 2>/dev/null
    fi
}

# Determine captures to compare
if [ -z "$CAPTURE2" ]; then
    # No captures specified - use latest and its parent
    CAPTURE2=$(get_latest_capture)
    if [ -z "$CAPTURE2" ]; then
        echo -e "${RED}Error: No captures found in index.json${NC}"
        exit 1
    fi
    CAPTURE1=$(get_capture_parent "$CAPTURE2")
    if [ -z "$CAPTURE1" ] || [ "$CAPTURE1" == "null" ]; then
        CAPTURE1="baseline"
    fi
elif [ -z "$CAPTURE1" ]; then
    # Only one capture specified - compare to its parent
    CAPTURE1=$(get_capture_parent "$CAPTURE2")
    if [ -z "$CAPTURE1" ] || [ "$CAPTURE1" == "null" ]; then
        CAPTURE1="baseline"
    fi
fi

# Resolve capture directories
DIR1="$CAPTURES_DIR/$CAPTURE1"
DIR2="$CAPTURES_DIR/$CAPTURE2"

# Fall back to old structure if new structure doesn't exist
if [ ! -d "$DIR1" ] && [ -d "$SCREENSHOT_DIR/$CAPTURE1" ]; then
    DIR1="$SCREENSHOT_DIR/$CAPTURE1"
fi
if [ ! -d "$DIR2" ] && [ -d "$SCREENSHOT_DIR/$CAPTURE2" ]; then
    DIR2="$SCREENSHOT_DIR/$CAPTURE2"
fi

# Verify directories exist
if [ ! -d "$DIR1" ]; then
    echo -e "${RED}Error: Capture not found: $CAPTURE1${NC}"
    echo "Available captures:"
    if [ -f "$INDEX_FILE" ]; then
        jq -r '.captures[].id' "$INDEX_FILE" 2>/dev/null | sed 's/^/  /'
    fi
    exit 1
fi

if [ ! -d "$DIR2" ]; then
    echo -e "${RED}Error: Capture not found: $CAPTURE2${NC}"
    exit 1
fi

echo "Comparing:"
echo "  Base: $CAPTURE1"
echo "  New:  $CAPTURE2"
echo ""

# Create diff output directory
DIFF_OUTPUT_DIR="$DIFFS_DIR/${CAPTURE1}_${CAPTURE2}"
mkdir -p "$DIFF_OUTPUT_DIR"

# Results tracking
declare -a UNCHANGED_SCREENS
declare -a CHANGED_SCREENS
declare -a NEW_SCREENS
declare -a MISSING_SCREENS

# Compare each screenshot
compare_screenshots() {
    local base_dir="$1"
    local new_dir="$2"

    # Get all screenshots from both directories
    local all_files=$( (ls "$base_dir"/*.png 2>/dev/null | xargs -n1 basename; ls "$new_dir"/*.png 2>/dev/null | xargs -n1 basename) | sort -u )

    for file in $all_files; do
        local base_file="$base_dir/$file"
        local new_file="$new_dir/$file"
        local diff_file="$DIFF_OUTPUT_DIR/${file%.png}-diff.png"
        local screen_name="${file%.png}"

        # Check if file exists in both directories
        if [ ! -f "$base_file" ]; then
            NEW_SCREENS+=("$screen_name")
            echo -e "  ${GREEN}+ NEW:${NC} $screen_name"
            continue
        fi

        if [ ! -f "$new_file" ]; then
            MISSING_SCREENS+=("$screen_name")
            echo -e "  ${RED}- MISSING:${NC} $screen_name"
            continue
        fi

        # Compare files
        if $USE_IMAGEMAGICK; then
            # Get pixel difference percentage
            local diff_result=$(compare -fuzz ${FUZZ_TOLERANCE}% -metric AE "$base_file" "$new_file" "$diff_file" 2>&1 || true)
            local diff_pixels=$(echo "$diff_result" | grep -o '[0-9]*' | head -1 || echo "0")

            # Get image dimensions for percentage calculation
            local total_pixels=$(identify -format '%w*%h\n' "$base_file" | bc)

            if [ "$total_pixels" -gt 0 ] && [ -n "$diff_pixels" ]; then
                local diff_percent=$(echo "scale=4; $diff_pixels * 100 / $total_pixels" | bc)

                if (( $(echo "$diff_percent > $SIGNIFICANT_THRESHOLD" | bc -l) )); then
                    CHANGED_SCREENS+=("$screen_name:$diff_percent")
                    echo -e "  ${RED}! CHANGED:${NC} $screen_name (${diff_percent}% different)"
                elif (( $(echo "$diff_percent > $DIFF_THRESHOLD" | bc -l) )); then
                    CHANGED_SCREENS+=("$screen_name:$diff_percent")
                    echo -e "  ${YELLOW}~ changed:${NC} $screen_name (${diff_percent}% different)"
                else
                    UNCHANGED_SCREENS+=("$screen_name")
                    rm -f "$diff_file"  # Remove diff file for unchanged screenshots
                fi
            else
                # Fallback to file comparison
                if cmp -s "$base_file" "$new_file"; then
                    UNCHANGED_SCREENS+=("$screen_name")
                else
                    CHANGED_SCREENS+=("$screen_name:unknown")
                    echo -e "  ${YELLOW}~ changed:${NC} $screen_name"
                fi
            fi
        else
            # Simple file comparison without ImageMagick
            if cmp -s "$base_file" "$new_file"; then
                UNCHANGED_SCREENS+=("$screen_name")
            else
                CHANGED_SCREENS+=("$screen_name:unknown")
                echo -e "  ${YELLOW}~ changed:${NC} $screen_name"
            fi
        fi
    done
}

echo "Comparing screenshots..."
compare_screenshots "$DIR1" "$DIR2"

# Summary
echo ""
echo -e "${BLUE}=== Summary ===${NC}"
echo -e "  ${GREEN}Unchanged:${NC} ${#UNCHANGED_SCREENS[@]}"
echo -e "  ${YELLOW}Changed:${NC}   ${#CHANGED_SCREENS[@]}"
echo -e "  ${GREEN}New:${NC}       ${#NEW_SCREENS[@]}"
echo -e "  ${RED}Missing:${NC}   ${#MISSING_SCREENS[@]}"

# Save diff metadata
cat > "$DIFF_OUTPUT_DIR/metadata.json" << EOF
{
  "base": "$CAPTURE1",
  "target": "$CAPTURE2",
  "timestamp": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "unchanged": ${#UNCHANGED_SCREENS[@]},
  "changed": ${#CHANGED_SCREENS[@]},
  "new": ${#NEW_SCREENS[@]},
  "missing": ${#MISSING_SCREENS[@]},
  "changedScreens": $(printf '%s\n' "${CHANGED_SCREENS[@]}" | jq -R 'split(":") | {id: .[0], percent: .[1]}' | jq -s '.' 2>/dev/null || echo "[]"),
  "newScreens": $(printf '%s\n' "${NEW_SCREENS[@]}" | jq -R '.' | jq -s '.' 2>/dev/null || echo "[]"),
  "missingScreens": $(printf '%s\n' "${MISSING_SCREENS[@]}" | jq -R '.' | jq -s '.' 2>/dev/null || echo "[]")
}
EOF

# Generate HTML report if requested
if $GENERATE_HTML; then
    HTML_FILE="$DIFF_OUTPUT_DIR/report.html"

    cat > "$HTML_FILE" << 'HTMLHEAD'
<!DOCTYPE html>
<html>
<head>
    <title>Darwin - Screenshot Diff Report</title>
    <style>
        body { font-family: -apple-system, BlinkMacSystemFont, sans-serif; margin: 20px; background: #1a1a1a; color: #fff; }
        h1 { color: #fff; display: flex; align-items: center; gap: 10px; }
        h1::before { content: "🧬"; }
        .summary { display: flex; gap: 20px; margin-bottom: 30px; }
        .stat { padding: 15px 25px; border-radius: 8px; }
        .stat.unchanged { background: #1d4a1d; }
        .stat.changed { background: #4a4a1d; }
        .stat.new { background: #1d4a4a; }
        .stat.missing { background: #4a1d1d; }
        .screen { margin-bottom: 30px; padding: 20px; background: #2a2a2a; border-radius: 8px; }
        .screen h3 { margin-top: 0; }
        .images { display: flex; gap: 10px; flex-wrap: wrap; }
        .images img { max-width: 300px; border-radius: 4px; }
        .label { font-size: 12px; color: #888; margin-bottom: 5px; }
        .diff-highlight { border: 2px solid #ff6b6b; }
        .footer { margin-top: 40px; color: #666; font-size: 12px; }
    </style>
</head>
<body>
    <h1>Darwin - Screenshot Diff Report</h1>
HTMLHEAD

    # Use relative paths for images
    BASE_REL="../captures/$CAPTURE1"
    TARGET_REL="../captures/$CAPTURE2"

    # Fall back to old structure paths if needed
    if [ ! -d "$CAPTURES_DIR/$CAPTURE1" ]; then
        BASE_REL="../$CAPTURE1"
    fi
    if [ ! -d "$CAPTURES_DIR/$CAPTURE2" ]; then
        TARGET_REL="../$CAPTURE2"
    fi

    echo "<p>Comparing <strong>$CAPTURE1</strong> → <strong>$CAPTURE2</strong></p>" >> "$HTML_FILE"

    echo '<div class="summary">' >> "$HTML_FILE"
    echo "<div class=\"stat unchanged\"><strong>${#UNCHANGED_SCREENS[@]}</strong> Unchanged</div>" >> "$HTML_FILE"
    echo "<div class=\"stat changed\"><strong>${#CHANGED_SCREENS[@]}</strong> Changed</div>" >> "$HTML_FILE"
    echo "<div class=\"stat new\"><strong>${#NEW_SCREENS[@]}</strong> New</div>" >> "$HTML_FILE"
    echo "<div class=\"stat missing\"><strong>${#MISSING_SCREENS[@]}</strong> Missing</div>" >> "$HTML_FILE"
    echo '</div>' >> "$HTML_FILE"

    # Show changed screens
    if [ ${#CHANGED_SCREENS[@]} -gt 0 ]; then
        echo '<h2>Changed Screens</h2>' >> "$HTML_FILE"
        for entry in "${CHANGED_SCREENS[@]}"; do
            screen="${entry%%:*}"
            percent="${entry#*:}"
            echo "<div class=\"screen\">" >> "$HTML_FILE"
            echo "<h3>$screen ($percent% different)</h3>" >> "$HTML_FILE"
            echo '<div class="images">' >> "$HTML_FILE"
            echo "<div><div class=\"label\">Before ($CAPTURE1)</div><img src=\"$BASE_REL/${screen}.png\"></div>" >> "$HTML_FILE"
            echo "<div><div class=\"label\">After ($CAPTURE2)</div><img src=\"$TARGET_REL/${screen}.png\"></div>" >> "$HTML_FILE"
            if [ -f "$DIFF_OUTPUT_DIR/${screen}-diff.png" ]; then
                echo "<div><div class=\"label\">Diff</div><img src=\"${screen}-diff.png\" class=\"diff-highlight\"></div>" >> "$HTML_FILE"
            fi
            echo '</div></div>' >> "$HTML_FILE"
        done
    fi

    # Show new screens
    if [ ${#NEW_SCREENS[@]} -gt 0 ]; then
        echo '<h2>New Screens</h2>' >> "$HTML_FILE"
        for screen in "${NEW_SCREENS[@]}"; do
            echo "<div class=\"screen\">" >> "$HTML_FILE"
            echo "<h3>$screen</h3>" >> "$HTML_FILE"
            echo '<div class="images">' >> "$HTML_FILE"
            echo "<div><div class=\"label\">New ($CAPTURE2)</div><img src=\"$TARGET_REL/${screen}.png\"></div>" >> "$HTML_FILE"
            echo '</div></div>' >> "$HTML_FILE"
        done
    fi

    echo '<div class="footer">Generated by Darwin - Watch your iOS app evolve</div>' >> "$HTML_FILE"
    echo '</body></html>' >> "$HTML_FILE"

    echo ""
    echo -e "${GREEN}HTML report generated:${NC} $HTML_FILE"
    echo "Open with: open \"$HTML_FILE\""
fi

# List changed files
if [ ${#CHANGED_SCREENS[@]} -gt 0 ]; then
    echo ""
    echo -e "${YELLOW}Changed screens:${NC}"
    for entry in "${CHANGED_SCREENS[@]}"; do
        screen="${entry%%:*}"
        echo "  - $screen"
    done
fi

echo ""
echo -e "${CYAN}Diff saved to:${NC} $DIFF_OUTPUT_DIR"

# Contextual next steps
echo ""
echo -e "${CYAN}What's next?${NC}"
if [ ${#CHANGED_SCREENS[@]} -gt 0 ] || [ ${#NEW_SCREENS[@]} -gt 0 ]; then
    if [ "$GENERATE_HTML" = false ]; then
        echo "  View detailed report:"
        echo "    ${GREEN}darwin diff --html${NC}          # Generate HTML diff report"
        echo ""
    fi
    echo "  Explore visually:"
    echo "    ${GREEN}darwin viewer${NC}               # Interactive timeline viewer"
    echo ""
    echo "  Continue iterating:"
    echo "    1. Make more changes"
    echo "    2. ${GREEN}darwin capture${NC}              # Capture new state"
else
    echo "  No changes detected! Your UI is stable."
    echo "  Continue development and run ${GREEN}darwin capture${NC} after changes."
fi

echo ""
echo -e "${GREEN}🧬 Done${NC}"
