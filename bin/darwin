#!/bin/bash
#
# Darwin - Watch your iOS app evolve
# Git-aware visual regression testing and development timelapse for iOS
#
# Usage: darwin <command> [options]
#

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
VERSION="1.1.2"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

print_banner() {
    echo ""
    echo -e "${GREEN}🧬 Darwin${NC} v${VERSION}"
    echo "   Watch your iOS app evolve"
    echo ""
}

print_usage() {
    print_banner
    echo "Usage: darwin <command> [options]"
    echo ""
    echo "Commands:"
    echo "  init        Initialize darwin in current project"
    echo "  capture     Capture screenshots (smart by default)"
    echo "  diff        Compare screenshots between commits"
    echo "  viewer      Open unified viewer (single/compare/timelapse/map)"
    echo "  status      Show current darwin state"
    echo "  hook        Install/manage git hooks for auto-capture"
    echo "  manifest    Sync manifest with tests (generate stubs)"
    echo "  detect      Auto-detect new SwiftUI views"
    echo "  version     Show version"
    echo "  help        Show this help message"
    echo ""
    echo "Quick Start:"
    echo "  darwin init                    # 1. Set up darwin in your project"
    echo "  darwin capture --baseline      # 2. Capture baseline screenshots"
    echo "  # ... make changes ..."
    echo "  darwin capture                 # 3. Smart capture changed screens"
    echo "  darwin viewer                  # 4. See your app evolve!"
    echo ""
    echo "Automation:"
    echo "  darwin hook install            # Auto-prompt after commits"
    echo "  darwin hook install --auto     # Auto-capture after commits"
    echo ""
    echo "For more info on a command: darwin <command> --help"
}

# Check for required dependencies
check_dependencies() {
    local missing=()

    if ! command -v xcodebuild &> /dev/null; then
        missing+=("xcodebuild (Xcode)")
    fi

    if ! command -v git &> /dev/null; then
        missing+=("git")
    fi

    if [ ${#missing[@]} -gt 0 ]; then
        echo -e "${RED}Error: Missing required dependencies:${NC}"
        for dep in "${missing[@]}"; do
            echo "  - $dep"
        done
        exit 1
    fi
}

case "${1:-}" in
    init)
        shift
        check_dependencies
        exec "$SCRIPT_DIR/darwin-init" "$@"
        ;;
    capture)
        shift
        check_dependencies
        exec "$SCRIPT_DIR/darwin-capture" "$@"
        ;;
    diff)
        shift
        exec "$SCRIPT_DIR/darwin-diff" "$@"
        ;;
    map)
        shift
        exec "$SCRIPT_DIR/darwin-map" "$@"
        ;;
    viewer)
        shift
        exec "$SCRIPT_DIR/darwin-viewer" "$@"
        ;;
    hook)
        shift
        exec "$SCRIPT_DIR/darwin-hook" "$@"
        ;;
    status)
        shift
        exec "$SCRIPT_DIR/darwin-status" "$@"
        ;;
    manifest)
        shift
        exec "$SCRIPT_DIR/darwin-manifest" "$@"
        ;;
    detect)
        shift
        exec "$SCRIPT_DIR/darwin-detect" "$@"
        ;;
    version|--version|-v)
        echo "darwin $VERSION"
        ;;
    help|--help|-h|"")
        print_usage
        ;;
    *)
        echo -e "${RED}Error: Unknown command '$1'${NC}"
        echo ""
        print_usage
        exit 1
        ;;
esac
