#!/bin/bash
#
# Darwin - Watch your iOS app evolve
# Git-aware visual regression testing and development timelapse for iOS
#
# Usage: darwin <command> [options]
#

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
VERSION="1.0.0"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

print_banner() {
    echo ""
    echo -e "${GREEN}🧬 Darwin${NC} v${VERSION}"
    echo "   Watch your iOS app evolve"
    echo ""
}

print_usage() {
    print_banner
    echo "Usage: darwin <command> [options]"
    echo ""
    echo "Commands:"
    echo "  init        Initialize darwin in current project"
    echo "  capture     Capture screenshots (smart by default)"
    echo "  diff        Compare screenshots between commits"
    echo "  version     Show version"
    echo "  help        Show this help message"
    echo ""
    echo "Examples:"
    echo "  darwin init                    # Set up darwin in your iOS project"
    echo "  darwin capture --baseline      # Capture baseline screenshots"
    echo "  darwin capture --smart         # Capture only changed screens"
    echo "  darwin diff baseline HEAD      # Compare baseline to current"
    echo "  darwin diff HEAD~3 HEAD --html # Compare with HTML report"
    echo ""
    echo "For more info on a command: darwin <command> --help"
}

# Check for required dependencies
check_dependencies() {
    local missing=()

    if ! command -v xcodebuild &> /dev/null; then
        missing+=("xcodebuild (Xcode)")
    fi

    if ! command -v git &> /dev/null; then
        missing+=("git")
    fi

    if [ ${#missing[@]} -gt 0 ]; then
        echo -e "${RED}Error: Missing required dependencies:${NC}"
        for dep in "${missing[@]}"; do
            echo "  - $dep"
        done
        exit 1
    fi
}

case "${1:-}" in
    init)
        shift
        check_dependencies
        exec "$SCRIPT_DIR/darwin-init" "$@"
        ;;
    capture)
        shift
        check_dependencies
        exec "$SCRIPT_DIR/darwin-capture" "$@"
        ;;
    diff)
        shift
        exec "$SCRIPT_DIR/darwin-diff" "$@"
        ;;
    version|--version|-v)
        echo "darwin $VERSION"
        ;;
    help|--help|-h|"")
        print_usage
        ;;
    *)
        echo -e "${RED}Error: Unknown command '$1'${NC}"
        echo ""
        print_usage
        exit 1
        ;;
esac
