#!/bin/bash
#
# darwin-parse
#
# Parse Swift source files to extract tap targets and navigation patterns.
# Outputs elements.json with detected NavigationLinks, sheets, and buttons.
#
# Usage:
#   darwin parse                # Parse all screens in manifest
#   darwin parse --screen ID    # Parse specific screen
#   darwin parse --output FILE  # Custom output file
#

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
LIB_DIR="$SCRIPT_DIR/../lib"

# Source configuration
if [ -f "$LIB_DIR/config.sh" ]; then
    source "$LIB_DIR/config.sh"
fi

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

# Try to load config
if load_config 2>/dev/null; then
    SCREENSHOT_DIR="$CONFIG_OUTPUT_PATH"
    MANIFEST_FILE="$CONFIG_MANIFEST_PATH"
else
    SCREENSHOT_DIR="$(pwd)/Screenshots"
    MANIFEST_FILE="$(pwd)/Screenshots/manifest.json"
fi

OUTPUT_FILE="$SCREENSHOT_DIR/elements.json"
SCREEN_FILTER=""
VERBOSE=false

# Parse arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        --screen|-s)
            SCREEN_FILTER="$2"
            shift 2
            ;;
        --output|-o)
            OUTPUT_FILE="$2"
            shift 2
            ;;
        --verbose|-v)
            VERBOSE=true
            shift
            ;;
        --help|-h)
            echo "Usage: darwin parse [OPTIONS]"
            echo ""
            echo "Parse Swift source files to extract tap targets and navigation patterns."
            echo ""
            echo "Options:"
            echo "  --screen, -s ID     Parse only specific screen"
            echo "  --output, -o FILE   Output file (default: Screenshots/elements.json)"
            echo "  --verbose, -v       Show detailed parsing info"
            echo "  --help              Show this help"
            echo ""
            echo "Detected patterns:"
            echo "  - NavigationLink(\"Label\", value: Screen.destination)"
            echo "  - NavigationLink(value: Screen.destination) { ... }"
            echo "  - .sheet(isPresented: \$showVar) { View() }"
            echo "  - .sheet(item: \$item) { ... }"
            echo "  - Button actions with navigation"
            exit 0
            ;;
        *)
            echo -e "${RED}Unknown option: $1${NC}"
            exit 1
            ;;
    esac
done

echo -e "${BLUE}🧬 Darwin - Parsing Swift Sources${NC}"
echo ""

# Check for manifest
if [ ! -f "$MANIFEST_FILE" ]; then
    echo -e "${RED}Error: manifest.json not found at $MANIFEST_FILE${NC}"
    exit 1
fi

# Get project root (where manifest is, or current directory)
PROJECT_ROOT="$(dirname "$MANIFEST_FILE")"
if [ "$PROJECT_ROOT" = "Screenshots" ] || [ "$PROJECT_ROOT" = "./Screenshots" ]; then
    PROJECT_ROOT="$(pwd)"
fi

# Parse a single Swift file and extract navigation patterns
parse_swift_file() {
    local file="$1"
    local screen_id="$2"

    if [ ! -f "$file" ]; then
        [ "$VERBOSE" = true ] && echo -e "  ${YELLOW}File not found: $file${NC}"
        return
    fi

    [ "$VERBOSE" = true ] && echo -e "  ${CYAN}Parsing: $file${NC}"

    local content
    content=$(cat "$file")

    # Pattern 1: NavigationLink("Label", value: EnumType.case)
    # Example: NavigationLink("Jellyfin", value: SettingsScreen.jellyfin)
    echo "$content" | grep -n 'NavigationLink\s*(' | while read -r line; do
        local line_num="${line%%:*}"
        local line_content="${line#*:}"

        # Extract label (first string argument)
        local label=""
        if [[ "$line_content" =~ NavigationLink\(\"([^\"]+)\" ]]; then
            label="${BASH_REMATCH[1]}"
        fi

        # Extract value destination
        local destination=""
        if [[ "$line_content" =~ value:\s*([A-Za-z0-9_]+)\.([a-zA-Z0-9_]+) ]]; then
            local enum_type="${BASH_REMATCH[1]}"
            local enum_case="${BASH_REMATCH[2]}"
            destination="${enum_type}.${enum_case}"
        fi

        if [ -n "$destination" ]; then
            echo "NAVLINK|$screen_id|$label|$destination|$line_num|navigation"
        fi
    done

    # Pattern 2: .sheet(isPresented: $showVar) { ViewName() }
    # Example: .sheet(isPresented: $showLogin) { LoginView() }
    echo "$content" | grep -n '\.sheet\s*(isPresented:' | while read -r line; do
        local line_num="${line%%:*}"
        local line_content="${line#*:}"

        # Extract trigger variable
        local trigger=""
        if [[ "$line_content" =~ isPresented:\s*\$([a-zA-Z0-9_]+) ]]; then
            trigger="${BASH_REMATCH[1]}"
        fi

        # Try to find the view in the same line or next few lines
        local view=""
        # Simple case: view on same line
        if [[ "$line_content" =~ \{\s*([A-Z][a-zA-Z0-9_]*)(View)?\s*\( ]]; then
            view="${BASH_REMATCH[1]}${BASH_REMATCH[2]}"
        fi

        if [ -n "$trigger" ]; then
            echo "SHEET|$screen_id|$trigger|$view|$line_num|sheet"
        fi
    done

    # Pattern 3: .sheet(item: $itemVar) { item in ... }
    echo "$content" | grep -n '\.sheet\s*(item:' | while read -r line; do
        local line_num="${line%%:*}"
        local line_content="${line#*:}"

        local trigger=""
        if [[ "$line_content" =~ item:\s*\$([a-zA-Z0-9_]+) ]]; then
            trigger="${BASH_REMATCH[1]}"
        fi

        if [ -n "$trigger" ]; then
            echo "SHEET_ITEM|$screen_id|$trigger||$line_num|sheet"
        fi
    done

    # Pattern 4: .accessibilityIdentifier("identifier")
    # Collect all accessibility identifiers in the file
    echo "$content" | grep -n '\.accessibilityIdentifier\s*(' | while read -r line; do
        local line_num="${line%%:*}"
        local line_content="${line#*:}"

        local identifier=""
        if [[ "$line_content" =~ accessibilityIdentifier\(\"([^\"]+)\" ]]; then
            identifier="${BASH_REMATCH[1]}"
        fi

        if [ -n "$identifier" ]; then
            echo "ACCESSID|$screen_id|$identifier||$line_num|"
        fi
    done
}

# Build the elements JSON
build_elements_json() {
    local screens_json="{}"

    # Get screen IDs from manifest
    local screen_ids
    if [ -n "$SCREEN_FILTER" ]; then
        screen_ids="$SCREEN_FILTER"
    else
        screen_ids=$(jq -r '.screens | keys[]' "$MANIFEST_FILE")
    fi

    for screen_id in $screen_ids; do
        echo -e "Processing: ${GREEN}$screen_id${NC}"

        # Get source files for this screen
        local sources
        sources=$(jq -r ".screens[\"$screen_id\"].sources // [] | .[]" "$MANIFEST_FILE" 2>/dev/null)

        local elements_array="[]"
        local elem_idx=0

        for source in $sources; do
            # Try to find the file relative to project root
            local file_path=""
            if [ -f "$PROJECT_ROOT/$source" ]; then
                file_path="$PROJECT_ROOT/$source"
            elif [ -f "$source" ]; then
                file_path="$source"
            else
                # Search in common locations
                for search_dir in "." ".." "../.." "$PROJECT_ROOT/.." "$PROJECT_ROOT/../.."; do
                    if [ -f "$search_dir/$source" ]; then
                        file_path="$search_dir/$source"
                        break
                    fi
                done
            fi

            if [ -z "$file_path" ]; then
                [ "$VERBOSE" = true ] && echo -e "  ${YELLOW}Source not found: $source${NC}"
                continue
            fi

            # Parse the Swift file
            local parsed
            parsed=$(parse_swift_file "$file_path" "$screen_id")

            # Convert parsed output to JSON elements
            while IFS='|' read -r type screen label dest line flow_type; do
                [ -z "$type" ] && continue

                case "$type" in
                    NAVLINK)
                        local elem_json
                        elem_json=$(jq -n \
                            --arg id "elem_$elem_idx" \
                            --arg type "NavigationLink" \
                            --arg label "$label" \
                            --arg dest "$dest" \
                            --arg source "$source" \
                            --arg line "$line" \
                            --arg flowType "$flow_type" \
                            '{
                                id: $id,
                                type: $type,
                                label: $label,
                                destination: { type: "enum", value: $dest },
                                sourceFile: $source,
                                sourceLine: ($line | tonumber),
                                flowType: $flowType,
                                accessibilityId: null,
                                coordinates: null
                            }')
                        elements_array=$(echo "$elements_array" | jq ". + [$elem_json]")
                        ((elem_idx++))
                        ;;
                    SHEET|SHEET_ITEM)
                        local elem_json
                        elem_json=$(jq -n \
                            --arg id "elem_$elem_idx" \
                            --arg type "sheet" \
                            --arg trigger "$label" \
                            --arg view "$dest" \
                            --arg source "$source" \
                            --arg line "$line" \
                            --arg flowType "$flow_type" \
                            '{
                                id: $id,
                                type: $type,
                                triggerVariable: $trigger,
                                destinationView: (if $view == "" then null else $view end),
                                sourceFile: $source,
                                sourceLine: ($line | tonumber),
                                flowType: $flowType,
                                accessibilityId: null,
                                coordinates: null
                            }')
                        elements_array=$(echo "$elements_array" | jq ". + [$elem_json]")
                        ((elem_idx++))
                        ;;
                    ACCESSID)
                        # Store accessibility IDs for later matching
                        [ "$VERBOSE" = true ] && echo "    Found accessibilityIdentifier: $label at line $line"
                        ;;
                esac
            done <<< "$parsed"
        done

        # Add screen elements to the main object
        if [ "$elements_array" != "[]" ]; then
            screens_json=$(echo "$screens_json" | jq \
                --arg screen "$screen_id" \
                --argjson elements "$elements_array" \
                '. + { ($screen): { elements: $elements } }')
        fi
    done

    # Build final JSON
    jq -n \
        --arg version "1.0" \
        --argjson screens "$screens_json" \
        '{
            version: $version,
            generatedAt: (now | strftime("%Y-%m-%dT%H:%M:%SZ")),
            screens: $screens
        }'
}

# Main execution
echo "Manifest: $MANIFEST_FILE"
echo "Output: $OUTPUT_FILE"
echo ""

RESULT=$(build_elements_json)

# Write output
mkdir -p "$(dirname "$OUTPUT_FILE")"
echo "$RESULT" | jq '.' > "$OUTPUT_FILE"

# Summary
TOTAL_ELEMENTS=$(echo "$RESULT" | jq '[.screens[].elements | length] | add // 0')
TOTAL_SCREENS=$(echo "$RESULT" | jq '.screens | length')

echo ""
echo -e "${GREEN}✓ Parsing complete${NC}"
echo "  Screens analyzed: $TOTAL_SCREENS"
echo "  Elements found: $TOTAL_ELEMENTS"
echo "  Output: $OUTPUT_FILE"
echo ""
echo -e "${YELLOW}Note: Review elements.json and update manifest flows_to with element IDs${NC}"
