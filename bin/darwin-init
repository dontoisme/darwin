#!/bin/bash
#
# darwin-init
#
# Initialize Darwin in an iOS project.
# Creates darwin.json config and Screenshots directory with manifest.json.
#
# Usage:
#   darwin init                    # Interactive setup
#   darwin init --project MyApp.xcodeproj --scheme MyApp
#

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
TEMPLATES_DIR="$SCRIPT_DIR/../templates"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

echo ""
echo -e "${GREEN}🧬 Darwin - Project Setup${NC}"
echo "   Watch your iOS app evolve"
echo ""

# Parse arguments
ARG_PROJECT=""
ARG_SCHEME=""
ARG_DESTINATION=""
ARG_TEST_TARGET=""
ARG_MODE=""
SKIP_PROMPTS=false
COPY_TEMPLATES=false
WITH_AI_RULES=false
AI_MODE=false
AI_INTERACTIVE=false

# Automation settings (defaults for Autopilot mode)
MODE="autopilot"
DETECT_NEW_VIEWS=true
ADD_VIEWS_TO_MANIFEST=true
CAPTURE_AFTER_COMMIT=true
OPEN_VIEWER_AFTER_CAPTURE=true

while [[ $# -gt 0 ]]; do
    case "$1" in
        --project)
            ARG_PROJECT="$2"
            shift 2
            ;;
        --scheme)
            ARG_SCHEME="$2"
            shift 2
            ;;
        --destination)
            ARG_DESTINATION="$2"
            shift 2
            ;;
        --test-target)
            ARG_TEST_TARGET="$2"
            shift 2
            ;;
        --mode)
            ARG_MODE="$2"
            shift 2
            ;;
        --yes|-y)
            SKIP_PROMPTS=true
            shift
            ;;
        --with-templates)
            COPY_TEMPLATES=true
            shift
            ;;
        --with-ai-rules)
            WITH_AI_RULES=true
            shift
            ;;
        --ai)
            AI_MODE=true
            SKIP_PROMPTS=true
            shift
            ;;
        --ai-interactive)
            AI_MODE=true
            AI_INTERACTIVE=true
            shift
            ;;
        --help|-h)
            echo "Usage: darwin init [OPTIONS]"
            echo ""
            echo "Options:"
            echo "  --project FILE      Xcode project or workspace file"
            echo "  --scheme NAME       Build scheme name"
            echo "  --destination DEST  Simulator destination string"
            echo "  --test-target NAME  UI test target name (default: <project>UITests)"
            echo "  --mode MODE         Automation mode: autopilot, guided, manual, custom"
            echo "  --with-templates    Copy Swift template files to project"
            echo "  --with-ai-rules     Generate AI coding assistant rules"
            echo "  -y, --yes           Skip prompts, use Autopilot mode"
            echo "  --ai                AI-initiated mode: non-interactive with handoff instructions"
            echo "  --ai-interactive    AI mode with structured prompts for Claude Code UI"
            echo "  --help              Show this help"
            echo ""
            echo "Modes:"
            echo "  autopilot   Everything automatic after commits (recommended)"
            echo "  guided      Prompts after commits - you decide what to run"
            echo "  manual      You run commands when needed - no automation"
            echo "  custom      Configure each behavior individually"
            echo ""
            echo "Examples:"
            echo "  darwin init"
            echo "  darwin init --project MyApp.xcodeproj --scheme MyApp"
            echo "  darwin init --mode autopilot --yes"
            exit 0
            ;;
        *)
            echo -e "${RED}Unknown option: $1${NC}"
            exit 1
            ;;
    esac
done

# Check if already initialized
if [ -f "darwin.json" ]; then
    if [ "$AI_MODE" = true ] || [ "$AI_INTERACTIVE" = true ]; then
        # AI mode with existing config - don't reinitialize, suggest next steps
        echo -e "${GREEN}✓ Darwin is already configured in this project.${NC}"
        echo ""
        echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo -e "${CYAN}  Darwin Already Set Up${NC}"
        echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        echo ""
        echo "To detect new screens:    darwin detect --add"
        echo "To capture screenshots:   darwin capture --baseline"
        echo "To view the timeline:     darwin viewer"
        echo ""
        echo "To reinitialize:          darwin init (will prompt to overwrite)"
        echo ""
        echo -e "${CYAN}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
        exit 0
    else
        # Interactive mode - prompt to overwrite
        echo -e "${YELLOW}Warning: darwin.json already exists in this directory.${NC}"
        read -p "Overwrite? [y/N] " -n 1 -r
        echo
        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
            echo "Aborted."
            exit 0
        fi
    fi
fi

# Auto-detect project
PROJECT=""
if [ -n "$ARG_PROJECT" ]; then
    PROJECT="$ARG_PROJECT"
else
    # Look for .xcodeproj or .xcworkspace
    XCODEPROJ=$(ls -d *.xcodeproj 2>/dev/null | head -1 || echo "")
    XCWORKSPACE=$(ls -d *.xcworkspace 2>/dev/null | head -1 || echo "")

    if [ -n "$XCWORKSPACE" ]; then
        PROJECT="$XCWORKSPACE"
    elif [ -n "$XCODEPROJ" ]; then
        PROJECT="$XCODEPROJ"
    fi
fi

if [ -z "$PROJECT" ]; then
    echo -e "${RED}Error: No Xcode project or workspace found.${NC}"
    echo "Run this command from your iOS project root, or specify --project."
    exit 1
fi

echo -e "${GREEN}Found:${NC} $PROJECT"

# AI-Interactive Mode: Output structured questions for Claude Code UI
if [ "$AI_INTERACTIVE" = true ]; then
    # Get available schemes
    SCHEMES=""
    if [[ "$PROJECT" == *.xcworkspace ]]; then
        SCHEMES=$(xcodebuild -workspace "$PROJECT" -list 2>/dev/null | grep -A100 "Schemes:" | tail -n +2 | head -10 | sed 's/^ *//' | tr '\n' '|' | sed 's/|$//')
    else
        SCHEMES=$(xcodebuild -project "$PROJECT" -list 2>/dev/null | grep -A100 "Schemes:" | tail -n +2 | head -10 | sed 's/^ *//' | tr '\n' '|' | sed 's/|$//')
    fi

    # Get available simulators
    SIMULATORS=$(xcrun simctl list devices available 2>/dev/null | grep -E "iPhone" | grep -v "unavailable" | head -8 | sed 's/^ *//' | sed 's/ (.*//' | tr '\n' '|' | sed 's/|$//')

    # Default scheme (strip .xcodeproj/.xcworkspace extension)
    DEFAULT_SCHEME=$(basename "$PROJECT" .xcodeproj)
    DEFAULT_SCHEME=$(basename "$DEFAULT_SCHEME" .xcworkspace)

    # Output structured questions for Claude Code
    echo ""
    echo "DARWIN_AI_QUESTIONS_START"
    cat << EOF
{
  "questions": [
    {
      "id": "scheme",
      "question": "Which scheme should Darwin use for building?",
      "type": "select",
      "options": ["$SCHEMES"],
      "default": "$DEFAULT_SCHEME"
    },
    {
      "id": "destination",
      "question": "Which simulator should Darwin use for screenshots?",
      "type": "select",
      "options": ["$SIMULATORS"],
      "default": "iPhone 17 Pro"
    },
    {
      "id": "mode",
      "question": "How automated should Darwin be?",
      "type": "select",
      "options": ["Autopilot - Everything automatic after commits|Guided - Prompts after commits|Manual - You run commands when needed"],
      "default": "Autopilot - Everything automatic after commits"
    }
  ],
  "continue_with": "darwin init --ai --scheme <scheme> --destination 'platform=iOS Simulator,name=<destination>' --mode <mode>"
}
EOF
    echo "DARWIN_AI_QUESTIONS_END"
    echo ""
    echo "Please present these questions to the user using your native UI,"
    echo "then run the continue_with command with the user's selections."
    exit 0
fi

# Determine scheme
SCHEME=""
if [ -n "$ARG_SCHEME" ]; then
    SCHEME="$ARG_SCHEME"
else
    # Default to project name without extension
    SCHEME=$(basename "$PROJECT" | sed 's/\.\(xcodeproj\|xcworkspace\)$//')
fi

# List available schemes
echo ""
echo "Available schemes:"
if [[ "$PROJECT" == *.xcworkspace ]]; then
    xcodebuild -workspace "$PROJECT" -list 2>/dev/null | grep -A100 "Schemes:" | tail -n +2 | head -20 | sed 's/^/  /'
else
    xcodebuild -project "$PROJECT" -list 2>/dev/null | grep -A100 "Schemes:" | tail -n +2 | head -20 | sed 's/^/  /'
fi

if [ "$SKIP_PROMPTS" != true ]; then
    echo ""
    echo -e "${CYAN}Press enter to accept the default, or type a different scheme name.${NC}"
    read -p "Scheme [$SCHEME]: " INPUT_SCHEME
    if [ -n "$INPUT_SCHEME" ]; then
        SCHEME="$INPUT_SCHEME"
    fi
fi

# Determine test target
TEST_TARGET=""
if [ -n "$ARG_TEST_TARGET" ]; then
    TEST_TARGET="$ARG_TEST_TARGET"
else
    TEST_TARGET="${SCHEME}UITests"
fi

# Check if test target exists
TEST_TARGET_EXISTS=false
if [ -d "$TEST_TARGET" ] || find . -maxdepth 2 -type d -name "$TEST_TARGET" 2>/dev/null | grep -q .; then
    TEST_TARGET_EXISTS=true
fi

if [ "$SKIP_PROMPTS" != true ]; then
    echo ""
    if [ "$TEST_TARGET_EXISTS" = false ]; then
        echo -e "${YELLOW}Note: UI Test target '$TEST_TARGET' not found in project.${NC}"
        echo -e "${CYAN}You may need to create one in Xcode: File > New > Target > UI Testing Bundle${NC}"
        echo -e "${CYAN}See: https://github.com/dontoisme/darwin#creating-a-ui-test-target${NC}"
        echo ""
    fi
    echo -e "${CYAN}Press enter to accept the default.${NC}"
    read -p "UI Test Target [$TEST_TARGET]: " INPUT_TEST_TARGET
    if [ -n "$INPUT_TEST_TARGET" ]; then
        TEST_TARGET="$INPUT_TEST_TARGET"
    fi
fi

# Determine destination - show available simulators
DESTINATION=""
if [ -n "$ARG_DESTINATION" ]; then
    DESTINATION="$ARG_DESTINATION"
else
    DESTINATION="platform=iOS Simulator,name=iPhone 17 Pro,OS=26.1"
fi

if [ "$SKIP_PROMPTS" != true ]; then
    echo ""
    echo "Available iPhone simulators:"

    # Get list of available iPhone simulators
    SIMULATORS=$(xcrun simctl list devices available 2>/dev/null | grep -E "iPhone|iPad" | grep -v "unavailable" | head -10 | sed 's/^ *//' | nl -w2 -s') ')
    echo "$SIMULATORS"
    echo ""
    echo -e "${CYAN}Enter a number to select, or press enter for the default.${NC}"
    read -p "Destination [$DESTINATION]: " INPUT_DEST

    # Check if input is a number (selection from list)
    if [[ "$INPUT_DEST" =~ ^[0-9]+$ ]]; then
        SELECTED_SIM=$(xcrun simctl list devices available 2>/dev/null | grep -E "iPhone|iPad" | grep -v "unavailable" | head -10 | sed -n "${INPUT_DEST}p" | sed 's/^ *//' | sed 's/ (.*//')
        if [ -n "$SELECTED_SIM" ]; then
            DESTINATION="platform=iOS Simulator,name=$SELECTED_SIM"
        fi
    elif [ -n "$INPUT_DEST" ]; then
        DESTINATION="$INPUT_DEST"
    fi
fi

# Mode selection
if [ -n "$ARG_MODE" ]; then
    MODE="$ARG_MODE"
elif [ "$SKIP_PROMPTS" = true ]; then
    MODE="autopilot"
else
    echo ""
    echo -e "${CYAN}🧬 How do you want Darwin to work?${NC}"
    echo ""
    echo -e "  ${GREEN}[1] Autopilot${NC} (Recommended)"
    echo "      Everything automatic - detect, capture, view after each commit"
    echo ""
    echo "  [2] Guided"
    echo "      Prompts after commits - you decide what to run"
    echo ""
    echo "  [3] Manual"
    echo "      You run commands when needed - no automation"
    echo ""
    echo "  [4] Custom"
    echo "      Configure each behavior individually"
    echo ""
    read -p "Choose [1-4, default=1]: " MODE_CHOICE

    case "$MODE_CHOICE" in
        2)
            MODE="guided"
            DETECT_NEW_VIEWS=true
            ADD_VIEWS_TO_MANIFEST=false  # Prompt instead
            CAPTURE_AFTER_COMMIT=false   # Prompt instead
            OPEN_VIEWER_AFTER_CAPTURE=true
            ;;
        3)
            MODE="manual"
            DETECT_NEW_VIEWS=false
            ADD_VIEWS_TO_MANIFEST=false
            CAPTURE_AFTER_COMMIT=false
            OPEN_VIEWER_AFTER_CAPTURE=false
            ;;
        4)
            MODE="custom"
            echo ""
            echo -e "${CYAN}Configure automation:${NC}"

            read -p "Auto-detect new views after commit? [Y/n]: " RESP
            case "$RESP" in [Nn]*) DETECT_NEW_VIEWS=false ;; *) DETECT_NEW_VIEWS=true ;; esac

            read -p "Auto-track newly detected screens? [Y/n]: " RESP
            case "$RESP" in [Nn]*) ADD_VIEWS_TO_MANIFEST=false ;; *) ADD_VIEWS_TO_MANIFEST=true ;; esac

            read -p "Auto-capture screenshots after commit? [Y/n]: " RESP
            case "$RESP" in [Nn]*) CAPTURE_AFTER_COMMIT=false ;; *) CAPTURE_AFTER_COMMIT=true ;; esac

            read -p "Auto-open viewer after capture? [Y/n]: " RESP
            case "$RESP" in [Nn]*) OPEN_VIEWER_AFTER_CAPTURE=false ;; *) OPEN_VIEWER_AFTER_CAPTURE=true ;; esac
            ;;
        1|"")
            # Autopilot mode - ask about viewer
            MODE="autopilot"
            DETECT_NEW_VIEWS=true
            ADD_VIEWS_TO_MANIFEST=true
            CAPTURE_AFTER_COMMIT=true
            echo ""
            echo -e "${CYAN}Viewer preference:${NC}"
            echo "  [1] Auto-open viewer after each capture (Recommended)"
            echo "  [2] I'll open viewer manually when needed"
            read -p "Choose [1-2, default=1]: " VIEWER_CHOICE
            case "$VIEWER_CHOICE" in
                2) OPEN_VIEWER_AFTER_CAPTURE=false ;;
                *) OPEN_VIEWER_AFTER_CAPTURE=true ;;
            esac
            ;;
        *)
            # Invalid choice - default to Autopilot with auto-open
            MODE="autopilot"
            DETECT_NEW_VIEWS=true
            ADD_VIEWS_TO_MANIFEST=true
            CAPTURE_AFTER_COMMIT=true
            OPEN_VIEWER_AFTER_CAPTURE=true
            ;;
    esac
fi

# AI Rules prompt (FTUE)
AI_RULES_GENERATED=false
if [ "$WITH_AI_RULES" = true ]; then
    # Flag specified - generate without prompting
    echo ""
    "$SCRIPT_DIR/darwin-ai-rules" --from-init --yes
    AI_RULES_GENERATED=true
elif [ "$SKIP_PROMPTS" != true ]; then
    echo ""
    echo -e "${CYAN}🤖 AI Coding Assistant Setup${NC}"
    echo "   Darwin can generate rules for AI tools (Claude Code, Cursor)"
    echo "   to write Darwin-compatible code automatically."
    echo ""
    read -p "Generate AI coding rules? [y/N]: " -n 1 -r
    echo
    if [[ $REPLY =~ ^[Yy]$ ]]; then
        "$SCRIPT_DIR/darwin-ai-rules" --from-init
        AI_RULES_GENERATED=true
    fi
fi

# Create darwin.json
echo ""
echo -e "${BLUE}Creating darwin.json...${NC}"

cat > "darwin.json" << EOF
{
  "project": "$PROJECT",
  "scheme": "$SCHEME",
  "testTarget": "$TEST_TARGET",
  "testClass": "ScreenshotTests",
  "destination": "$DESTINATION",
  "outputDir": "Screenshots",
  "manifest": "Screenshots/manifest.json",
  "resultsDir": "TestResults",
  "mode": "$MODE",
  "automation": {
    "detectNewViews": $DETECT_NEW_VIEWS,
    "addViewsToManifest": $ADD_VIEWS_TO_MANIFEST,
    "captureAfterCommit": $CAPTURE_AFTER_COMMIT,
    "openViewerAfterCapture": $OPEN_VIEWER_AFTER_CAPTURE
  }
}
EOF

echo -e "${GREEN}Created:${NC} darwin.json"

# Create Screenshots directory
mkdir -p Screenshots

# Create manifest.json if it doesn't exist
if [ ! -f "Screenshots/manifest.json" ]; then
    echo -e "${BLUE}Creating Screenshots/manifest.json...${NC}"

    cat > "Screenshots/manifest.json" << 'EOF'
{
  "version": "1.0",
  "description": "Screenshot manifest - maps screens to source files",
  "screens": {
    "01-home": {
      "name": "Home",
      "description": "Main home screen",
      "test": "testScreenshot_01_Home",
      "sources": [
        "Sources/Views/HomeView.swift"
      ]
    }
  }
}
EOF

    echo -e "${GREEN}Created:${NC} Screenshots/manifest.json"
fi

# Auto-detect screens and populate manifest
SCREENS_ADDED=0
if [ "$AI_MODE" = true ]; then
    # AI mode: automatically detect and add screens
    echo ""
    echo -e "${CYAN}Scanning codebase for screens...${NC}"

    DETECTED=$("$SCRIPT_DIR/darwin-detect" --list 2>/dev/null || echo "")
    if [ -n "$DETECTED" ]; then
        SCREEN_COUNT=$(echo "$DETECTED" | wc -l | tr -d ' ')
        if [ "$SCREEN_COUNT" -gt 0 ]; then
            echo -e "  ${GREEN}✓${NC} Found $SCREEN_COUNT screen-like views"
            "$SCRIPT_DIR/darwin-detect" --add --yes 2>/dev/null
            SCREENS_ADDED=$SCREEN_COUNT
            echo -e "  ${GREEN}✓${NC} Added to manifest"
        fi
    fi
elif [ "$SKIP_PROMPTS" != true ]; then
    echo ""
    echo -e "${CYAN}Scanning codebase for screens...${NC}"

    # Run detect in list mode to get view names
    DETECTED=$("$SCRIPT_DIR/darwin-detect" --list 2>/dev/null || echo "")
    if [ -n "$DETECTED" ]; then
        SCREEN_COUNT=$(echo "$DETECTED" | wc -l | tr -d ' ')

        if [ "$SCREEN_COUNT" -gt 0 ]; then
            echo -e "  ${GREEN}✓${NC} Found $SCREEN_COUNT screen-like views"
            echo ""

            # Show first 5 views
            echo "$DETECTED" | head -5 | while read -r view; do
                echo "    $view"
            done
            [ "$SCREEN_COUNT" -gt 5 ] && echo "    ... and $((SCREEN_COUNT - 5)) more"
            echo ""

            read -p "Track these screens with Darwin? [Y/n]: " ADD_SCREENS_RESP
            if [[ ! $ADD_SCREENS_RESP =~ ^[Nn]$ ]]; then
                "$SCRIPT_DIR/darwin-detect" --add --yes 2>/dev/null
                SCREENS_ADDED=$SCREEN_COUNT
                echo -e "  ${GREEN}✓${NC} Updated manifest with $SCREEN_COUNT screens"
            fi
        fi
    else
        echo -e "  ${DIM}No SwiftUI views detected (will use template manifest)${NC}"
    fi
fi

# Generate test stubs
TESTS_GENERATED=false
if [ "$AI_MODE" = true ] && [ "$SCREENS_ADDED" -gt 0 ]; then
    # AI mode: automatically generate test stubs
    echo ""
    echo -e "${CYAN}Generating test stubs...${NC}"
    TEST_FILE_PATH="$TEST_TARGET/ScreenshotTests.swift"
    "$SCRIPT_DIR/darwin-manifest" sync --generate-file "$TEST_FILE_PATH" 2>/dev/null
    echo -e "  ${GREEN}✓${NC} Created $TEST_FILE_PATH"

    # Copy helper templates
    HELPERS_DIR="$TEST_TARGET/Helpers"
    mkdir -p "$HELPERS_DIR"
    if [ -d "$TEMPLATES_DIR" ]; then
        cp "$TEMPLATES_DIR/XCUIApplication+Screenshots.swift" "$HELPERS_DIR/" 2>/dev/null && \
            echo -e "  ${GREEN}✓${NC} Copied XCUIApplication+Screenshots.swift"
        cp "$TEMPLATES_DIR/BaseScreenshotTests.swift" "$HELPERS_DIR/" 2>/dev/null && \
            echo -e "  ${GREEN}✓${NC} Copied BaseScreenshotTests.swift"
    fi
    TESTS_GENERATED=true
elif [ "$SKIP_PROMPTS" != true ] && [ "$SCREENS_ADDED" -gt 0 ]; then
    echo ""
    read -p "Generate test stubs? [Y/n]: " GEN_TESTS_RESP
    if [[ ! $GEN_TESTS_RESP =~ ^[Nn]$ ]]; then
        # Create test file
        TEST_FILE_PATH="$TEST_TARGET/ScreenshotTests.swift"
        "$SCRIPT_DIR/darwin-manifest" sync --generate-file "$TEST_FILE_PATH" 2>/dev/null
        echo -e "  ${GREEN}✓${NC} Created $TEST_FILE_PATH"

        # Copy helper templates
        HELPERS_DIR="$TEST_TARGET/Helpers"
        mkdir -p "$HELPERS_DIR"
        if [ -d "$TEMPLATES_DIR" ]; then
            cp "$TEMPLATES_DIR/XCUIApplication+Screenshots.swift" "$HELPERS_DIR/" 2>/dev/null && \
                echo -e "  ${GREEN}✓${NC} Copied XCUIApplication+Screenshots.swift"
            cp "$TEMPLATES_DIR/BaseScreenshotTests.swift" "$HELPERS_DIR/" 2>/dev/null && \
                echo -e "  ${GREEN}✓${NC} Copied BaseScreenshotTests.swift"
        fi
        TESTS_GENERATED=true
    fi
fi

# Demo viewer prompt (skip in AI mode - no point opening browser)
if [ "$SKIP_PROMPTS" != true ] && [ "$AI_MODE" != true ]; then
    echo ""
    read -p "See what Darwin looks like? [Y/n]: " SHOW_DEMO_RESP
    if [[ ! $SHOW_DEMO_RESP =~ ^[Nn]$ ]]; then
        echo -e "  → Opening demo viewer..."
        open "https://dontoisme.github.io/darwin/demo/" 2>/dev/null || \
            echo "  Visit: https://dontoisme.github.io/darwin/demo/"
    fi
fi

# Copy templates if requested (legacy flag - now handled above)
if [ "$COPY_TEMPLATES" = true ] && [ -d "$TEMPLATES_DIR" ]; then
    echo ""
    echo -e "${BLUE}Copying Swift templates...${NC}"

    # Create Helpers directory in test target
    HELPERS_DIR="$TEST_TARGET/Helpers"
    mkdir -p "$HELPERS_DIR"

    # Copy templates
    for template in "$TEMPLATES_DIR"/*.swift; do
        if [ -f "$template" ]; then
            cp "$template" "$HELPERS_DIR/"
            echo -e "${GREEN}Copied:${NC} $(basename "$template") -> $HELPERS_DIR/"
        fi
    done
fi

# Add to .gitignore
if [ -f ".gitignore" ]; then
    if ! grep -q "TestResults" ".gitignore"; then
        echo "" >> ".gitignore"
        echo "# Darwin screenshot testing" >> ".gitignore"
        echo "TestResults/" >> ".gitignore"
        echo "Screenshots/diff/" >> ".gitignore"
        echo -e "${GREEN}Updated:${NC} .gitignore"
    fi
fi

# Install git hook based on mode
install_hook() {
    if [ "$MODE" = "autopilot" ]; then
        echo ""
        echo -e "${BLUE}Installing git hook (auto mode)...${NC}"
        "$SCRIPT_DIR/darwin-hook" install --auto 2>/dev/null && \
            echo -e "${GREEN}Installed:${NC} Post-commit hook (autopilot mode)" || \
            echo -e "${YELLOW}Note:${NC} Could not install hook. Run 'darwin hook install --auto' manually."
    elif [ "$MODE" = "guided" ]; then
        echo ""
        echo -e "${BLUE}Installing git hook (prompt mode)...${NC}"
        "$SCRIPT_DIR/darwin-hook" install 2>/dev/null && \
            echo -e "${GREEN}Installed:${NC} Post-commit hook (guided mode)" || \
            echo -e "${YELLOW}Note:${NC} Could not install hook. Run 'darwin hook install' manually."
    elif [ "$MODE" = "custom" ]; then
        # Install hook if any automation is enabled
        if [ "$CAPTURE_AFTER_COMMIT" = true ] || [ "$DETECT_NEW_VIEWS" = true ]; then
            echo ""
            if [ "$CAPTURE_AFTER_COMMIT" = true ] && [ "$ADD_VIEWS_TO_MANIFEST" = true ]; then
                echo -e "${BLUE}Installing git hook (auto mode)...${NC}"
                "$SCRIPT_DIR/darwin-hook" install --auto 2>/dev/null && \
                    echo -e "${GREEN}Installed:${NC} Post-commit hook" || \
                    echo -e "${YELLOW}Note:${NC} Could not install hook."
            else
                echo -e "${BLUE}Installing git hook (prompt mode)...${NC}"
                "$SCRIPT_DIR/darwin-hook" install 2>/dev/null && \
                    echo -e "${GREEN}Installed:${NC} Post-commit hook" || \
                    echo -e "${YELLOW}Note:${NC} Could not install hook."
            fi
        fi
    fi
    # Manual mode: no hook installed
}

install_hook

# Summary - show focused next steps based on what was set up
echo ""

if [ "$TESTS_GENERATED" = true ]; then
    # Tests were generated - show focused next steps
    echo -e "${GREEN}═══════════════════════════════════════${NC}"
    echo -e "${GREEN}  Next: Add navigation to your tests${NC}"
    echo -e "${GREEN}═══════════════════════════════════════${NC}"
