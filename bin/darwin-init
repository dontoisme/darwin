    echo -e "  ${CYAN}$TEST_TARGET/ScreenshotTests.swift${NC}"
    echo ""
    echo "Each test needs navigation logic:"
    echo ""
    echo -e "  ${YELLOW}func testScreenshot_02_settings() {${NC}"
    echo -e "      ${GREEN}app.buttons[\"settings\"].tap()  // ← Add this${NC}"
    echo -e "      ${YELLOW}takeScreenshotWithElements(\"02-settings\", app: app)${NC}"
    echo -e "  ${YELLOW}}${NC}"
    echo ""
