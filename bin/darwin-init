#!/bin/bash
#
# darwin-init
#
# Initialize Darwin in an iOS project.
# Creates darwin.json config and Screenshots directory with manifest.json.
#
# Usage:
#   darwin init                    # Interactive setup
#   darwin init --project MyApp.xcodeproj --scheme MyApp
#

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
TEMPLATES_DIR="$SCRIPT_DIR/../templates"

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m'

echo ""
echo -e "${GREEN}🧬 Darwin - Project Setup${NC}"
echo "   Watch your iOS app evolve"
echo ""

# Check if already initialized
if [ -f "darwin.json" ]; then
    echo -e "${YELLOW}Warning: darwin.json already exists in this directory.${NC}"
    read -p "Overwrite? [y/N] " -n 1 -r
    echo
    if [[ ! $REPLY =~ ^[Yy]$ ]]; then
        echo "Aborted."
        exit 0
    fi
fi

# Parse arguments
ARG_PROJECT=""
ARG_SCHEME=""
ARG_DESTINATION=""
ARG_TEST_TARGET=""
ARG_MODE=""
SKIP_PROMPTS=false
COPY_TEMPLATES=false

# Automation settings (defaults for Autopilot mode)
MODE="autopilot"
DETECT_NEW_VIEWS=true
ADD_VIEWS_TO_MANIFEST=true
CAPTURE_AFTER_COMMIT=true
OPEN_VIEWER_AFTER_CAPTURE=true

while [[ $# -gt 0 ]]; do
    case "$1" in
        --project)
            ARG_PROJECT="$2"
            shift 2
            ;;
        --scheme)
            ARG_SCHEME="$2"
            shift 2
            ;;
        --destination)
            ARG_DESTINATION="$2"
            shift 2
            ;;
        --test-target)
            ARG_TEST_TARGET="$2"
            shift 2
            ;;
        --mode)
            ARG_MODE="$2"
            shift 2
            ;;
        --yes|-y)
            SKIP_PROMPTS=true
            shift
            ;;
        --with-templates)
            COPY_TEMPLATES=true
            shift
            ;;
        --help|-h)
            echo "Usage: darwin init [OPTIONS]"
            echo ""
            echo "Options:"
            echo "  --project FILE      Xcode project or workspace file"
            echo "  --scheme NAME       Build scheme name"
            echo "  --destination DEST  Simulator destination string"
            echo "  --test-target NAME  UI test target name (default: <project>UITests)"
            echo "  --mode MODE         Automation mode: autopilot, guided, manual, custom"
            echo "  --with-templates    Copy Swift template files to project"
            echo "  -y, --yes           Skip prompts, use Autopilot mode"
            echo "  --help              Show this help"
            echo ""
            echo "Modes:"
            echo "  autopilot   Everything automatic after commits (recommended)"
            echo "  guided      Prompts after commits - you decide what to run"
            echo "  manual      You run commands when needed - no automation"
            echo "  custom      Configure each behavior individually"
            echo ""
            echo "Examples:"
            echo "  darwin init"
            echo "  darwin init --project MyApp.xcodeproj --scheme MyApp"
            echo "  darwin init --mode autopilot --yes"
            exit 0
            ;;
        *)
            echo -e "${RED}Unknown option: $1${NC}"
            exit 1
            ;;
    esac
done

# Auto-detect project
PROJECT=""
if [ -n "$ARG_PROJECT" ]; then
    PROJECT="$ARG_PROJECT"
else
    # Look for .xcodeproj or .xcworkspace
    XCODEPROJ=$(ls -d *.xcodeproj 2>/dev/null | head -1 || echo "")
    XCWORKSPACE=$(ls -d *.xcworkspace 2>/dev/null | head -1 || echo "")

    if [ -n "$XCWORKSPACE" ]; then
        PROJECT="$XCWORKSPACE"
    elif [ -n "$XCODEPROJ" ]; then
        PROJECT="$XCODEPROJ"
    fi
fi

if [ -z "$PROJECT" ]; then
    echo -e "${RED}Error: No Xcode project or workspace found.${NC}"
    echo "Run this command from your iOS project root, or specify --project."
    exit 1
fi

echo -e "${GREEN}Found:${NC} $PROJECT"

# Determine scheme
SCHEME=""
if [ -n "$ARG_SCHEME" ]; then
    SCHEME="$ARG_SCHEME"
else
    # Default to project name without extension
    SCHEME=$(basename "$PROJECT" | sed 's/\.\(xcodeproj\|xcworkspace\)$//')
fi

# List available schemes
echo ""
echo "Available schemes:"
if [[ "$PROJECT" == *.xcworkspace ]]; then
    xcodebuild -workspace "$PROJECT" -list 2>/dev/null | grep -A100 "Schemes:" | tail -n +2 | head -20 | sed 's/^/  /'
else
    xcodebuild -project "$PROJECT" -list 2>/dev/null | grep -A100 "Schemes:" | tail -n +2 | head -20 | sed 's/^/  /'
fi

if [ "$SKIP_PROMPTS" != true ]; then
    echo ""
    read -p "Scheme [$SCHEME]: " INPUT_SCHEME
    if [ -n "$INPUT_SCHEME" ]; then
        SCHEME="$INPUT_SCHEME"
    fi
fi

# Determine test target
TEST_TARGET=""
if [ -n "$ARG_TEST_TARGET" ]; then
    TEST_TARGET="$ARG_TEST_TARGET"
else
    TEST_TARGET="${SCHEME}UITests"
fi

if [ "$SKIP_PROMPTS" != true ]; then
    read -p "UI Test Target [$TEST_TARGET]: " INPUT_TEST_TARGET
    if [ -n "$INPUT_TEST_TARGET" ]; then
        TEST_TARGET="$INPUT_TEST_TARGET"
    fi
fi

# Determine destination
DESTINATION=""
if [ -n "$ARG_DESTINATION" ]; then
    DESTINATION="$ARG_DESTINATION"
else
    DESTINATION="platform=iOS Simulator,name=iPhone 16 Pro"
fi

if [ "$SKIP_PROMPTS" != true ]; then
    echo ""
    echo "Simulator destinations (examples):"
    echo "  platform=iOS Simulator,name=iPhone 16 Pro"
    echo "  platform=iOS Simulator,name=iPhone 15,OS=17.0"
    read -p "Destination [$DESTINATION]: " INPUT_DEST
    if [ -n "$INPUT_DEST" ]; then
        DESTINATION="$INPUT_DEST"
    fi
fi

# Mode selection
if [ -n "$ARG_MODE" ]; then
    MODE="$ARG_MODE"
elif [ "$SKIP_PROMPTS" = true ]; then
    MODE="autopilot"
else
    echo ""
    echo -e "${CYAN}🧬 How do you want Darwin to work?${NC}"
    echo ""
    echo -e "  ${GREEN}[1] Autopilot${NC} (Recommended)"
    echo "      Everything automatic - detect, capture, view after each commit"
    echo ""
    echo "  [2] Guided"
    echo "      Prompts after commits - you decide what to run"
    echo ""
    echo "  [3] Manual"
    echo "      You run commands when needed - no automation"
    echo ""
    echo "  [4] Custom"
    echo "      Configure each behavior individually"
    echo ""
    read -p "Choose [1-4, default=1]: " MODE_CHOICE

    case "$MODE_CHOICE" in
        2)
            MODE="guided"
            DETECT_NEW_VIEWS=true
            ADD_VIEWS_TO_MANIFEST=false  # Prompt instead
            CAPTURE_AFTER_COMMIT=false   # Prompt instead
            OPEN_VIEWER_AFTER_CAPTURE=true
            ;;
        3)
            MODE="manual"
            DETECT_NEW_VIEWS=false
            ADD_VIEWS_TO_MANIFEST=false
            CAPTURE_AFTER_COMMIT=false
            OPEN_VIEWER_AFTER_CAPTURE=false
            ;;
        4)
            MODE="custom"
            echo ""
            echo -e "${CYAN}Configure automation:${NC}"

            read -p "Auto-detect new views after commit? [Y/n]: " RESP
            case "$RESP" in [Nn]*) DETECT_NEW_VIEWS=false ;; *) DETECT_NEW_VIEWS=true ;; esac

            read -p "Auto-add detected views to manifest? [Y/n]: " RESP
            case "$RESP" in [Nn]*) ADD_VIEWS_TO_MANIFEST=false ;; *) ADD_VIEWS_TO_MANIFEST=true ;; esac

            read -p "Auto-capture screenshots after commit? [Y/n]: " RESP
            case "$RESP" in [Nn]*) CAPTURE_AFTER_COMMIT=false ;; *) CAPTURE_AFTER_COMMIT=true ;; esac

            read -p "Auto-open viewer after capture? [Y/n]: " RESP
            case "$RESP" in [Nn]*) OPEN_VIEWER_AFTER_CAPTURE=false ;; *) OPEN_VIEWER_AFTER_CAPTURE=true ;; esac
            ;;
        1|"")
            # Autopilot mode - ask about viewer
            MODE="autopilot"
            DETECT_NEW_VIEWS=true
            ADD_VIEWS_TO_MANIFEST=true
            CAPTURE_AFTER_COMMIT=true
            echo ""
            echo -e "${CYAN}Viewer preference:${NC}"
            echo "  [1] Auto-open viewer after each capture (Recommended)"
            echo "  [2] I'll open viewer manually when needed"
            read -p "Choose [1-2, default=1]: " VIEWER_CHOICE
            case "$VIEWER_CHOICE" in
                2) OPEN_VIEWER_AFTER_CAPTURE=false ;;
                *) OPEN_VIEWER_AFTER_CAPTURE=true ;;
            esac
            ;;
        *)
            # Invalid choice - default to Autopilot with auto-open
            MODE="autopilot"
            DETECT_NEW_VIEWS=true
            ADD_VIEWS_TO_MANIFEST=true
            CAPTURE_AFTER_COMMIT=true
            OPEN_VIEWER_AFTER_CAPTURE=true
            ;;
    esac
fi

# Create darwin.json
echo ""
echo -e "${BLUE}Creating darwin.json...${NC}"

cat > "darwin.json" << EOF
{
  "project": "$PROJECT",
  "scheme": "$SCHEME",
  "testTarget": "$TEST_TARGET",
  "testClass": "ScreenshotTests",
  "destination": "$DESTINATION",
  "outputDir": "Screenshots",
  "manifest": "Screenshots/manifest.json",
  "resultsDir": "TestResults",
  "mode": "$MODE",
  "automation": {
    "detectNewViews": $DETECT_NEW_VIEWS,
    "addViewsToManifest": $ADD_VIEWS_TO_MANIFEST,
    "captureAfterCommit": $CAPTURE_AFTER_COMMIT,
    "openViewerAfterCapture": $OPEN_VIEWER_AFTER_CAPTURE
  }
}
EOF

echo -e "${GREEN}Created:${NC} darwin.json"

# Create Screenshots directory
mkdir -p Screenshots

# Create manifest.json if it doesn't exist
if [ ! -f "Screenshots/manifest.json" ]; then
    echo -e "${BLUE}Creating Screenshots/manifest.json...${NC}"

    cat > "Screenshots/manifest.json" << 'EOF'
{
  "version": "1.0",
  "description": "Screenshot manifest - maps screens to source files",
  "screens": {
    "01-home": {
      "name": "Home",
      "description": "Main home screen",
      "test": "testScreenshot_01_Home",
      "sources": [
        "Sources/Views/HomeView.swift"
      ]
    }
  }
}
EOF

    echo -e "${GREEN}Created:${NC} Screenshots/manifest.json"
    echo -e "${YELLOW}Note:${NC} Edit manifest.json to add your app's screens and source mappings."
fi

# Copy templates if requested
if [ "$COPY_TEMPLATES" = true ] && [ -d "$TEMPLATES_DIR" ]; then
    echo ""
    echo -e "${BLUE}Copying Swift templates...${NC}"

    # Create Helpers directory in test target
    HELPERS_DIR="$TEST_TARGET/Helpers"
    mkdir -p "$HELPERS_DIR"

    # Copy templates
    for template in "$TEMPLATES_DIR"/*.swift; do
        if [ -f "$template" ]; then
            cp "$template" "$HELPERS_DIR/"
            echo -e "${GREEN}Copied:${NC} $(basename "$template") -> $HELPERS_DIR/"
        fi
    done
fi

# Add to .gitignore
if [ -f ".gitignore" ]; then
    if ! grep -q "TestResults" ".gitignore"; then
        echo "" >> ".gitignore"
        echo "# Darwin screenshot testing" >> ".gitignore"
        echo "TestResults/" >> ".gitignore"
        echo "Screenshots/diff/" >> ".gitignore"
        echo -e "${GREEN}Updated:${NC} .gitignore"
    fi
fi

# Install git hook based on mode
install_hook() {
    if [ "$MODE" = "autopilot" ]; then
        echo ""
        echo -e "${BLUE}Installing git hook (auto mode)...${NC}"
        "$SCRIPT_DIR/darwin-hook" install --auto 2>/dev/null && \
            echo -e "${GREEN}Installed:${NC} Post-commit hook (autopilot mode)" || \
            echo -e "${YELLOW}Note:${NC} Could not install hook. Run 'darwin hook install --auto' manually."
    elif [ "$MODE" = "guided" ]; then
        echo ""
        echo -e "${BLUE}Installing git hook (prompt mode)...${NC}"
        "$SCRIPT_DIR/darwin-hook" install 2>/dev/null && \
            echo -e "${GREEN}Installed:${NC} Post-commit hook (guided mode)" || \
            echo -e "${YELLOW}Note:${NC} Could not install hook. Run 'darwin hook install' manually."
    elif [ "$MODE" = "custom" ]; then
        # Install hook if any automation is enabled
        if [ "$CAPTURE_AFTER_COMMIT" = true ] || [ "$DETECT_NEW_VIEWS" = true ]; then
            echo ""
            if [ "$CAPTURE_AFTER_COMMIT" = true ] && [ "$ADD_VIEWS_TO_MANIFEST" = true ]; then
                echo -e "${BLUE}Installing git hook (auto mode)...${NC}"
                "$SCRIPT_DIR/darwin-hook" install --auto 2>/dev/null && \
                    echo -e "${GREEN}Installed:${NC} Post-commit hook" || \
                    echo -e "${YELLOW}Note:${NC} Could not install hook."
            else
                echo -e "${BLUE}Installing git hook (prompt mode)...${NC}"
                "$SCRIPT_DIR/darwin-hook" install 2>/dev/null && \
                    echo -e "${GREEN}Installed:${NC} Post-commit hook" || \
                    echo -e "${YELLOW}Note:${NC} Could not install hook."
            fi
        fi
    fi
    # Manual mode: no hook installed
}

install_hook

# Summary
echo ""
echo -e "${GREEN}=== Darwin Initialized ===${NC}"
echo ""
echo "Configuration:"
echo "  Project:     $PROJECT"
echo "  Scheme:      $SCHEME"
echo "  Test Target: $TEST_TARGET"
echo "  Destination: $DESTINATION"
echo "  Mode:        $MODE"
echo ""
echo "Created files:"
echo "  darwin.json              - Configuration file"
echo "  Screenshots/             - Screenshot output directory"
echo "  Screenshots/manifest.json - Screen-to-source mapping"
echo ""

# Mode-specific next steps
case "$MODE" in
    autopilot)
        echo -e "${GREEN}🚀 You're all set!${NC} Darwin will automatically:"
        echo "   • Detect new SwiftUI views after commits"
        echo "   • Add them to manifest and generate test stubs"
        echo "   • Capture screenshots of affected screens"
        if [ "$OPEN_VIEWER_AFTER_CAPTURE" = true ]; then
            echo "   • Open the visual timeline"
        fi
        echo ""
        echo "Just commit as usual - Darwin handles the rest."
        if [ "$OPEN_VIEWER_AFTER_CAPTURE" = false ]; then
            echo "Run 'darwin viewer' anytime to see your visual timeline."
        fi
        echo ""
        echo -e "${YELLOW}To capture your baseline now:${NC}"
        echo "  darwin capture --baseline"
        ;;
    guided)
        echo -e "${CYAN}🎯 Guided mode enabled.${NC} After each commit, Darwin will:"
        echo "   • Detect new SwiftUI views and prompt to add them"
        echo "   • Show affected screens and prompt to capture"
        echo "   • Auto-open the visual timeline after capture"
        echo ""
        echo -e "${YELLOW}Next steps:${NC}"
        echo "  1. Edit Screenshots/manifest.json to add your screens"
        echo "  2. Run: darwin capture --baseline"
        ;;
    manual)
        echo -e "${BLUE}🛠️  Manual mode enabled.${NC} Run commands when you need them:"
        echo ""
        echo "  darwin detect      # Find new SwiftUI views"
        echo "  darwin capture     # Take screenshots"
        echo "  darwin viewer      # See visual timeline"
        echo "  darwin diff        # Compare captures"
        echo ""
        echo -e "${YELLOW}Next steps:${NC}"
        echo "  1. Edit Screenshots/manifest.json to add your screens"
        echo "  2. Add accessibility identifiers to your views"
        echo "  3. Create $TEST_TARGET/ScreenshotTests.swift"
        echo "  4. Run: darwin capture --baseline"
        ;;
    custom)
        echo -e "${CYAN}⚙️  Custom mode configured:${NC}"
        echo "   • Detect new views:     $DETECT_NEW_VIEWS"
        echo "   • Auto-add to manifest: $ADD_VIEWS_TO_MANIFEST"
        echo "   • Capture after commit: $CAPTURE_AFTER_COMMIT"
        echo "   • Open viewer:          $OPEN_VIEWER_AFTER_CAPTURE"
        echo ""
        echo -e "${YELLOW}Next steps:${NC}"
        echo "  1. Edit Screenshots/manifest.json to add your screens"
        echo "  2. Run: darwin capture --baseline"
        ;;
esac

echo ""
echo "See: https://github.com/dontoisme/darwin"
echo ""
echo -e "${GREEN}🧬 Ready to evolve!${NC}"
