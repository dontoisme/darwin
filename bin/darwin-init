    echo -e "  ${CYAN}darwin capture --baseline${NC}"
else
    # Standard summary
    echo -e "${GREEN}=== Darwin Initialized ===${NC}"
    echo ""
    echo "Configuration:"
    echo "  Project:     $PROJECT"
    echo "  Scheme:      $SCHEME"
    echo "  Test Target: $TEST_TARGET"
    echo "  Destination: $DESTINATION"
    echo "  Mode:        $MODE"
    echo ""
    echo "Created files:"
    echo "  darwin.json              - Configuration file"
    echo "  Screenshots/             - Screenshot output directory"
    echo "  Screenshots/manifest.json - Screen-to-source mapping"
    echo ""

    # Mode-specific next steps
    case "$MODE" in
        autopilot)
            echo -e "${GREEN}🚀 You're all set!${NC} Darwin will automatically:"
            echo "   • Detect new SwiftUI views after commits"
            echo "   • Add them to manifest and generate test stubs"
            echo "   • Capture screenshots of affected screens"
            if [ "$OPEN_VIEWER_AFTER_CAPTURE" = true ]; then
                echo "   • Open the visual timeline"
            fi
            echo ""
            echo "Just commit as usual - Darwin handles the rest."
            if [ "$OPEN_VIEWER_AFTER_CAPTURE" = false ]; then
                echo "Run 'darwin viewer' anytime to see your visual timeline."
            fi
            echo ""
            echo -e "${YELLOW}To capture your baseline now:${NC}"
            echo "  darwin capture --baseline"
            ;;
        guided)
            echo -e "${CYAN}🎯 Guided mode enabled.${NC} After each commit, Darwin will:"
            echo "   • Detect new SwiftUI views and prompt to add them"
            echo "   • Show affected screens and prompt to capture"
            echo "   • Auto-open the visual timeline after capture"
            echo ""
            echo -e "${YELLOW}Next steps:${NC}"
            echo "  1. Run: darwin detect --add   # Find and track your screens"
            echo "  2. Run: darwin capture --baseline"
            ;;
        manual)
            echo -e "${BLUE}🛠️  Manual mode enabled.${NC} Run commands when you need them:"
            echo ""
            echo "  darwin detect      # Find screens in your code"
            echo "  darwin capture     # Take screenshots"
            echo "  darwin viewer      # See visual timeline"
            echo "  darwin diff        # Compare captures"
            echo ""
            echo -e "${YELLOW}Next steps:${NC}"
            echo "  1. Run: darwin detect --add   # Find and track your screens"
            echo "  2. Add accessibility identifiers to your views"
            echo "  3. Create $TEST_TARGET/ScreenshotTests.swift"
            echo "  4. Run: darwin capture --baseline"
            ;;
        custom)
            echo -e "${CYAN}⚙️  Custom mode configured:${NC}"
            echo "   • Detect new views:     $DETECT_NEW_VIEWS"
            echo "   • Auto-track new screens: $ADD_VIEWS_TO_MANIFEST"
            echo "   • Capture after commit: $CAPTURE_AFTER_COMMIT"
            echo "   • Open viewer:          $OPEN_VIEWER_AFTER_CAPTURE"
            echo ""
            echo -e "${YELLOW}Next steps:${NC}"
            echo "  1. Run: darwin detect --add   # Find and track your screens"
            echo "  2. Run: darwin capture --baseline"
            ;;
    esac
fi

echo ""
echo "See: https://github.com/dontoisme/darwin"
echo ""

