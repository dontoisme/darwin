#!/bin/bash
#
# darwin-viewer
#
# Generate an interactive unified viewer for all screenshot captures.
# Supports: single view, compare, timelapse, and app map modes.
#
# Usage:
#   darwin viewer                # Generate and open viewer
#   darwin viewer --output FILE  # Custom output file
#

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
LIB_DIR="$SCRIPT_DIR/../lib"

# Source configuration
if [ -f "$LIB_DIR/config.sh" ]; then
    source "$LIB_DIR/config.sh"
fi

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

# Try to load config
if load_config 2>/dev/null; then
    SCREENSHOT_DIR="$CONFIG_OUTPUT_PATH"
    MANIFEST_FILE="$CONFIG_MANIFEST_PATH"
else
    SCREENSHOT_DIR="$(pwd)/Screenshots"
    MANIFEST_FILE="$(pwd)/Screenshots/manifest.json"
fi

INDEX_FILE="$SCREENSHOT_DIR/index.json"
OUTPUT_FILE="$SCREENSHOT_DIR/viewer.html"

# Defaults
GENERATE_ONLY=false

# Parse arguments
while [[ $# -gt 0 ]]; do
    case "$1" in
        --output|-o)
            OUTPUT_FILE="$2"
            shift 2
            ;;
        --generate-only)
            GENERATE_ONLY=true
            shift
            ;;
        --help|-h)
            echo "Usage: darwin viewer [OPTIONS]"
            echo ""
            echo "Generate an interactive unified screenshot viewer."
            echo ""
            echo "Options:"
            echo "  --output, -o FILE   Output HTML file (default: Screenshots/viewer.html)"
            echo "  --generate-only     Generate without opening browser"
            echo "  --help              Show this help"
            echo ""
            echo "Modes available in viewer:"
            echo "  - Single:    View any capture"
            echo "  - Compare:   Side-by-side diff between two captures"
            echo "  - Timelapse: Scrub through timeline, unchanged screens fade"
            echo "  - Map:       App flow visualization with connections"
            exit 0
            ;;
        *)
            echo -e "${RED}Unknown option: $1${NC}"
            exit 1
            ;;
    esac
done

echo -e "${BLUE}🧬 Darwin - Generating Unified Viewer${NC}"
echo ""

# Check for required files
if [ ! -f "$MANIFEST_FILE" ]; then
    echo -e "${RED}Error: manifest.json not found${NC}"
    exit 1
fi

if [ ! -f "$INDEX_FILE" ]; then
    echo -e "${YELLOW}Warning: index.json not found, creating empty one${NC}"
    mkdir -p "$SCREENSHOT_DIR"
    echo '{"version": "1.0", "captures": []}' > "$INDEX_FILE"
fi

echo "Manifest: $MANIFEST_FILE"
echo "Index: $INDEX_FILE"
echo "Output: $OUTPUT_FILE"
echo ""

# Read data
MANIFEST_JSON=$(cat "$MANIFEST_FILE")
INDEX_JSON=$(cat "$INDEX_FILE")

# Get change threshold from manifest (default 0.5%)
CHANGE_THRESHOLD=$(echo "$MANIFEST_JSON" | jq -r '.changeThreshold // 0.5')

# Get captures array
CAPTURES=$(echo "$INDEX_JSON" | jq -c '.captures[]')
CAPTURES_DIR="$SCREENSHOT_DIR/captures"

# Build change data objects
CHANGE_DATA="{}"
SOURCE_CHANGES="{}"
PREV_CAPTURE=""

# Check if we're in a git repo for source change detection
IN_GIT_REPO=false
if git rev-parse --is-inside-work-tree &>/dev/null; then
    IN_GIT_REPO=true
    echo "Detecting source file changes from git history..."
fi

# Check if ImageMagick is available for visual change detection
HAS_IMAGEMAGICK=false
if command -v compare &> /dev/null; then
    HAS_IMAGEMAGICK=true
    echo "Computing visual changes with ImageMagick..."
fi

while IFS= read -r capture; do
    CAPTURE_ID=$(echo "$capture" | jq -r '.id')
    CURRENT_COMMIT=$(echo "$capture" | jq -r '.commitFull // .commit')

    if [ -n "$PREV_CAPTURE" ] && [ "$PREV_CAPTURE" != "null" ]; then
        PREV_ID=$(echo "$PREV_CAPTURE" | jq -r '.id')
        PREV_COMMIT=$(echo "$PREV_CAPTURE" | jq -r '.commitFull // .commit')
        CAPTURE_CHANGES="{}"
        CAPTURE_SOURCE_CHANGES="[]"

        # Get git diff to find changed source files
        if [ "$IN_GIT_REPO" = true ] && [ -n "$PREV_COMMIT" ] && [ -n "$CURRENT_COMMIT" ]; then
            CHANGED_FILES=$(git diff --name-only "$PREV_COMMIT".."$CURRENT_COMMIT" 2>/dev/null || echo "")

            if [ -n "$CHANGED_FILES" ]; then
                # For each screen in manifest, check if any source file changed
                SCREEN_IDS=$(echo "$MANIFEST_JSON" | jq -r '.screens | keys[]')
                for SCREEN_ID in $SCREEN_IDS; do
                    # Get source files for this screen
                    SOURCES=$(echo "$MANIFEST_JSON" | jq -r ".screens[\"$SCREEN_ID\"].sources // [] | .[]")
                    for SOURCE in $SOURCES; do
                        if echo "$CHANGED_FILES" | grep -qF "$SOURCE"; then
                            CAPTURE_SOURCE_CHANGES=$(echo "$CAPTURE_SOURCE_CHANGES" | jq --arg id "$SCREEN_ID" '. + [$id] | unique')
                            break
                        fi
                    done
                done
            fi
        fi

        # Visual comparison with ImageMagick
        if [ "$HAS_IMAGEMAGICK" = true ]; then
            for screen_file in "$CAPTURES_DIR/$CAPTURE_ID"/*.png; do
                if [ -f "$screen_file" ]; then
                    SCREEN_NAME=$(basename "$screen_file")
                    PREV_FILE="$CAPTURES_DIR/$PREV_ID/$SCREEN_NAME"

                    if [ -f "$PREV_FILE" ]; then
                        # Get image dimensions to calculate total pixels
                        DIMENSIONS=$(identify -format "%w %h" "$screen_file" 2>/dev/null || echo "0 0")
                        WIDTH=$(echo "$DIMENSIONS" | cut -d' ' -f1)
                        HEIGHT=$(echo "$DIMENSIONS" | cut -d' ' -f2)
                        TOTAL_PIXELS=$((WIDTH * HEIGHT))

                        if [ "$TOTAL_PIXELS" -gt 0 ]; then
                            # Compare and get changed pixel count
                            CHANGED_PIXELS=$(compare -metric AE "$PREV_FILE" "$screen_file" /dev/null 2>&1 || true)
                            # Clean the output (remove any non-numeric characters)
                            CHANGED_PIXELS=$(echo "$CHANGED_PIXELS" | grep -oE '^[0-9]+' || echo "0")

                            # Calculate percentage
                            CHANGE_PCT=$(echo "scale=4; $CHANGED_PIXELS * 100 / $TOTAL_PIXELS" | bc)
                            SCREEN_ID="${SCREEN_NAME%.png}"
                            CAPTURE_CHANGES=$(echo "$CAPTURE_CHANGES" | jq --arg id "$SCREEN_ID" --arg pct "$CHANGE_PCT" '. + {($id): ($pct | tonumber)}')
                        fi
                    fi
                fi
            done
        fi

        # Add this capture's data
        CHANGE_DATA=$(echo "$CHANGE_DATA" | jq --arg id "$CAPTURE_ID" --argjson changes "$CAPTURE_CHANGES" '. + {($id): $changes}')
        SOURCE_CHANGES=$(echo "$SOURCE_CHANGES" | jq --arg id "$CAPTURE_ID" --argjson sources "$CAPTURE_SOURCE_CHANGES" '. + {($id): $sources}')
    fi

    PREV_CAPTURE="$capture"
done <<< "$CAPTURES"

# Inject change data into index JSON
INDEX_JSON=$(echo "$INDEX_JSON" | jq --argjson changes "$CHANGE_DATA" --argjson sources "$SOURCE_CHANGES" '. + {changeData: $changes, sourceChanges: $sources}')
echo "Change detection complete."

if [ "$HAS_IMAGEMAGICK" != true ]; then
    echo -e "${YELLOW}Note: Install ImageMagick for pixel-level change detection${NC}"
fi

# Generate the unified viewer HTML
cat > "$OUTPUT_FILE" << 'HTMLDOC'
