    <script>
        // Injected data
        const MANIFEST = __MANIFEST_JSON__;
        const INDEX = __INDEX_JSON__;
        const CAPTURES_DIR = "captures";

        // State
        let currentMode = 'map';
        let selectedCapture = null;
        let selectedCapture2 = null;
        let timelinePosition = 0;
        let isPlaying = false;

        // Evolution state
        let currentModalScreen = null;
        let evolutionCaptures = [];
        let evolutionIdx = 0;
        let evolutionIsPlaying = false;
        let evolutionTimer = null;
        let evolutionShowAll = false;

        // Mini-map panning state
        let miniMapPanX = 0;
        let miniMapPanY = 0;
        let miniMapIsPanning = false;
        let miniMapStartX = 0;
        let miniMapStartY = 0;

        // Map state
        let mapScale = 0.25;
        let mapTranslateX = 50;
        let mapTranslateY = 50;
        let isDragging = false;
        let dragStartX, dragStartY;

        // Timeline state for map
        let mapTimelineIdx = 0;
        let mapIsPlaying = false;
        let mapPlaybackSpeed = 1500; // ms per frame
        let mapPlaybackTimer = null;

        // Screen positions for map
        const screenPositions = {};

        // Cache for tracking which screens exist in each capture
        const captureScreensCache = {};

        // Filter state
        let activeGroups = new Set(); // empty = all groups shown
        let changeFilter = 'all'; // 'all', 'changed', 'new'
        let showFlows = true;
        let showAllScreens = false; // when true, don't fade unchanged screens
        let layoutDirection = 'vertical'; // 'horizontal' or 'vertical'

        function init() {
            populateCaptureSelects();
            setupEventListeners();
            renderMode();
        }

        function populateCaptureSelects() {
            const select1 = document.getElementById('captureSelect');
            const select2 = document.getElementById('captureSelect2');

            const captures = INDEX.captures || [];
            const lastIdx = captures.length - 1;

            captures.forEach((cap, idx) => {
                const date = new Date(cap.timestamp).toLocaleDateString();
                const isLatest = idx === lastIdx;
                const label = isLatest
                    ? `${cap.id} - ${date} (latest)`
                    : `${cap.id} - ${date}`;

                const opt1 = document.createElement('option');
                opt1.value = cap.id;
                opt1.textContent = label;
                select1.appendChild(opt1);

                const opt2 = document.createElement('option');
                opt2.value = cap.id;
                opt2.textContent = label;
                select2.appendChild(opt2);
            });

            if (captures.length > 0) {
                selectedCapture = captures[captures.length - 1].id;
                select1.value = selectedCapture;
                if (captures.length > 1) {
                    selectedCapture2 = captures[captures.length - 2].id;
                    select2.value = selectedCapture2;
                }
            }
        }

        function setupEventListeners() {
            document.querySelectorAll('.mode-tab').forEach(tab => {
                tab.addEventListener('click', () => {
                    document.querySelector('.mode-tab.active').classList.remove('active');
                    tab.classList.add('active');
                    currentMode = tab.dataset.mode;
                    renderMode();
                });
            });

            document.getElementById('captureSelect').addEventListener('change', (e) => {
                selectedCapture = e.target.value;
                renderMode();
            });

            document.getElementById('captureSelect2').addEventListener('change', (e) => {
                selectedCapture2 = e.target.value;
                renderMode();
            });

            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') closeModal();
            });
        }

        function renderMode() {
            const main = document.getElementById('main');
            const select2 = document.getElementById('captureSelect2');
            const mapToolbar = document.getElementById('mapToolbar');

            select2.style.display = currentMode === 'compare' ? 'block' : 'none';
            mapToolbar.classList.toggle('visible', currentMode === 'map');

            // Stop map playback when switching modes
            if (currentMode !== 'map' && mapIsPlaying) {
                mapIsPlaying = false;
                if (mapPlaybackTimer) {
                    clearTimeout(mapPlaybackTimer);
                    mapPlaybackTimer = null;
                }
            }

            switch (currentMode) {
                case 'single':
                    renderSingleView(main);
                    break;
                case 'compare':
                    renderCompareView(main);
                    break;
                case 'map':
                    populateGroupFilters();
                    renderMapView(main);
                    break;
            }
        }

        function populateGroupFilters() {
            const container = document.getElementById('groupFilters');
            const groups = MANIFEST.groups || {};

            container.innerHTML = Object.entries(groups).map(([id, group]) => `
                <button class="filter-btn" data-group="${id}" onclick="toggleGroupFilter('${id}')" style="--group-color: ${group.color}">
                    <span class="dot" style="background: ${group.color}"></span>${group.name}
                </button>
            `).join('');

            // Initialize with no groups selected (empty = show all)
            activeGroups = new Set();
        }

        function toggleGroupFilter(groupId) {
            // New behavior: clicking a group makes it the only selected group
            // Clicking the selected group deselects it (back to showing all)
            if (activeGroups.size === 1 && activeGroups.has(groupId)) {
                // Deselect the only selected group
                activeGroups.clear();
            } else {
                // Select only this group
                activeGroups.clear();
                activeGroups.add(groupId);
            }

            // Update button states
            document.querySelectorAll('.filter-btn[data-group]').forEach(button => {
                const btnGroupId = button.dataset.group;
                button.classList.toggle('active', activeGroups.has(btnGroupId));
            });

            applyMapFilters();
        }

        function setChangeFilter(filter) {
            changeFilter = filter;
            document.querySelectorAll('#changeFilters .filter-btn').forEach(btn => {
                btn.classList.toggle('active', btn.dataset.filter === filter);
            });
            applyMapFilters();
        }

        function toggleFlows() {
            showFlows = !showFlows;
            const btn = document.getElementById('showFlowsBtn');
            btn.classList.toggle('active', showFlows);
            document.querySelectorAll('.connection, .connection-arrow').forEach(el => {
                el.classList.toggle('hidden', !showFlows);
            });
        }

        function setLayout(direction) {
            layoutDirection = direction;
            document.getElementById('layoutHBtn').classList.toggle('active', direction === 'horizontal');
            document.getElementById('layoutVBtn').classList.toggle('active', direction === 'vertical');
            // Re-render the map with new layout
            renderMapView(document.getElementById('main'));
        }

        function toggleUnfade() {
            showAllScreens = !showAllScreens;
            const btn = document.getElementById('unfadeBtn');
            btn.classList.toggle('active', showAllScreens);
            btn.textContent = showAllScreens ? 'Highlight Changes' : 'Show All';
            // Re-apply timeline to update fading
            updateMapTimeline();
        }

        function toggleMobileMenu() {
            const toolbar = document.getElementById('mapToolbar');
            const btn = document.getElementById('mobileMenuBtn');
            toolbar.classList.toggle('mobile-open');
            btn.textContent = toolbar.classList.contains('mobile-open') ? '✕ Close' : '☰ Filters';
        }

        // Close mobile menu when clicking outside
        document.addEventListener('click', (e) => {
            const toolbar = document.getElementById('mapToolbar');
            const btn = document.getElementById('mobileMenuBtn');
            if (toolbar && toolbar.classList.contains('mobile-open')) {
                if (!toolbar.contains(e.target) && !btn.contains(e.target)) {
                    toolbar.classList.remove('mobile-open');
                    btn.textContent = '☰ Filters';
                }
            }
        });

        function applyMapFilters() {
            const groups = MANIFEST.groups || {};

            // Build set of visible screen IDs based on group filter
            const visibleByGroup = new Set();
            for (const [groupId, group] of Object.entries(groups)) {
                if (activeGroups.size === 0 || activeGroups.has(groupId)) {
                    (group.screens || []).forEach(screenId => visibleByGroup.add(screenId));
                }
            }

            // Apply visibility to each screen
            document.querySelectorAll('.map-screen').forEach(screenDiv => {
                const screenId = screenDiv.dataset.screenId;
                const isInActiveGroup = visibleByGroup.has(screenId);
                const isChanged = screenDiv.classList.contains('changed');
                const isNew = screenDiv.classList.contains('new-screen');

                let visible = isInActiveGroup;

                // Apply change filter
                if (changeFilter === 'changed') {
                    visible = visible && isChanged;
                } else if (changeFilter === 'new') {
                    visible = visible && isNew;
                }

                screenDiv.style.display = visible ? 'block' : 'none';
            });

            // Update connection visibility based on visible screens
            document.querySelectorAll('.connection, .connection-arrow').forEach(el => {
                if (!showFlows) {
                    el.classList.add('hidden');
                    return;
                }
                const from = el.dataset.from;
                const to = el.dataset.to;
                const fromVisible = document.getElementById(`map-screen-${from}`)?.style.display !== 'none';
                const toVisible = document.getElementById(`map-screen-${to}`)?.style.display !== 'none';
                el.classList.toggle('hidden', !fromVisible || !toVisible);
            });
        }

        function renderSingleView(container) {
            const screens = Object.entries(MANIFEST.screens);
            container.innerHTML = `
                <div class="view-single">
                    <div class="screen-grid">
                        ${screens.map(([id, screen]) => `
                            <div class="screen-card" onclick="openModal('${id}')">
                                <img src="${CAPTURES_DIR}/${selectedCapture}/${id}.png"
                                     onerror="this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22300%22 height=%22500%22><rect fill=%22%23161b22%22 width=%22300%22 height=%22500%22/><text x=%22150%22 y=%22250%22 fill=%22%238b949e%22 text-anchor=%22middle%22>Not captured</text></svg>'">
                                <div class="label">
                                    <h3>${screen.name}</h3>
                                    <div class="id">${id}</div>
                                </div>
                            </div>
                        `).join('')}
                    </div>
                </div>
            `;
        }

        function renderCompareView(container) {
            const screens = Object.entries(MANIFEST.screens);
            container.innerHTML = `
                <div class="filters">
                    <span class="filter-label">Show:</span>
                    <label class="filter-toggle">
                        <input type="checkbox" id="showChangedOnly">
                        Changed only
                    </label>
                </div>
                <div class="compare-container">
                    <div class="compare-column">
                        <h2>Base: ${selectedCapture2}</h2>
                        <div class="screen-grid" id="compareLeft">
                            ${screens.map(([id, screen]) => `
                                <div class="screen-card" data-id="${id}" onclick="openModal('${id}', '${selectedCapture2}')">
                                    <img src="${CAPTURES_DIR}/${selectedCapture2}/${id}.png" onerror="this.style.display='none'">
                                    <div class="label">
                                        <h3>${screen.name}</h3>
                                        <div class="id">${id}</div>
                                    </div>
                                </div>
                            `).join('')}
                        </div>
                    </div>
                    <div class="compare-column">
                        <h2>Target: ${selectedCapture}</h2>
                        <div class="screen-grid" id="compareRight">
                            ${screens.map(([id, screen]) => `
                                <div class="screen-card" data-id="${id}" onclick="openModal('${id}', '${selectedCapture}')">
                                    <img src="${CAPTURES_DIR}/${selectedCapture}/${id}.png" onerror="this.style.display='none'">
                                    <div class="label">
                                        <h3>${screen.name}</h3>
                                        <div class="id">${id}</div>
                                    </div>
                                </div>
                            `).join('')}
                        </div>
                    </div>
                </div>
            `;
        }

        function renderTimelapseView(container) {
            const captures = INDEX.captures || [];
            const screens = Object.entries(MANIFEST.screens);

            container.innerHTML = `
                <div class="filters">
                    <span class="filter-label">Highlight changes</span>
                    <label class="filter-toggle">
                        <input type="checkbox" id="fadeUnchanged" checked onchange="updateTimelapse()">
                        Fade unchanged
                    </label>
                </div>
                <div class="view-single" style="padding-bottom: 120px;">
                    <div class="screen-grid" id="timelapseGrid">
                        ${screens.map(([id, screen]) => `
                            <div class="screen-card" data-id="${id}" onclick="openModal('${id}')">
                                <img src="" data-screen="${id}"
                                     onerror="this.onerror=null; this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22300%22 height=%22500%22><rect fill=%22%23161b22%22 width=%22300%22 height=%22500%22/><text x=%22150%22 y=%22250%22 fill=%22%238b949e%22 text-anchor=%22middle%22 font-family=%22system-ui%22>Not in this capture</text></svg>'; this.parentElement.classList.add('faded');">
                                <div class="label">
                                    <h3>${screen.name}</h3>
                                    <div class="id">${id}</div>
                                </div>
                            </div>
                        `).join('')}
                    </div>
                </div>
                <div class="timelapse-controls">
                    <input type="range" class="timeline-slider" id="timelineSlider"
                           min="0" max="${captures.length - 1}" value="${captures.length - 1}"
                           oninput="updateTimelapse()">
                    <div class="timeline-info">
                        <span id="timelineDate"></span>
                        <span class="timeline-commit" id="timelineCommit"></span>
                        <button class="play-btn" onclick="togglePlay()">${isPlaying ? '⏸ Pause' : '▶ Play'}</button>
                    </div>
                </div>
            `;
            updateTimelapse();
        }

        function updateTimelapse() {
            const slider = document.getElementById('timelineSlider');
            const captures = INDEX.captures || [];
            const idx = parseInt(slider.value);
            const capture = captures[idx];

            if (!capture) return;

            document.getElementById('timelineDate').textContent = new Date(capture.timestamp).toLocaleDateString();
            document.getElementById('timelineCommit').textContent = capture.commit;

            // Update images
            document.querySelectorAll('#timelapseGrid img[data-screen]').forEach(img => {
                const screenId = img.dataset.screen;
                img.src = `${CAPTURES_DIR}/${capture.id}/${screenId}.png`;
            });

            // Fade unchanged if enabled
            const fadeUnchanged = document.getElementById('fadeUnchanged')?.checked;
            if (fadeUnchanged && idx > 0) {
                const prevCapture = captures[idx - 1];
                // In real implementation, we'd compare actual files
                // For now, just show all
            }
        }

        function togglePlay() {
            isPlaying = !isPlaying;
            if (isPlaying) {
                playTimelapse();
            }
        }

        function playTimelapse() {
            if (!isPlaying) return;
            const slider = document.getElementById('timelineSlider');
            const max = parseInt(slider.max);
            let val = parseInt(slider.value);

            if (val < max) {
                slider.value = val + 1;
                updateTimelapse();
                setTimeout(playTimelapse, 1000);
            } else {
                isPlaying = false;
            }
        }

        function renderMapView(container) {
            const captures = INDEX.captures || [];
            mapTimelineIdx = captures.length - 1; // Start at latest
            layoutScreensForMap();

            container.innerHTML = `
                <div class="map-container" id="mapContainer">
                    <div class="map-canvas" id="mapCanvas">
                        <svg class="map-connections" id="mapConnections"></svg>
                    </div>
                </div>
                <div class="map-timeline">
                    <div class="timeline-row">
                        <button class="timeline-btn" id="mapRewindBtn" onclick="mapRewind()" title="Go to beginning">
                            ⏮ Start
                        </button>
                        <button class="timeline-btn" id="mapPlayBtn" onclick="mapTogglePlay()">
                            ▶ Play
                        </button>
                        <button class="timeline-btn" id="mapStepBtn" onclick="mapStep()" title="Step forward">
                            ⏭ Step
                        </button>
                        <div class="timeline-track" id="mapTrack" onclick="mapTrackClick(event)">
                            <div class="timeline-progress" id="mapProgress"></div>
                            <div class="timeline-markers" id="mapMarkers">
                                ${captures.map((_, i) => `<div class="timeline-marker" data-idx="${i}" onclick="mapJumpTo(${i}); event.stopPropagation();"></div>`).join('')}
                            </div>
                        </div>
                        <select class="speed-select" id="mapSpeedSelect" onchange="mapSetSpeed(this.value)">
                            <option value="3000">0.5x</option>
                            <option value="1500" selected>1x</option>
                            <option value="750">2x</option>
                            <option value="400">4x</option>
                        </select>
                    </div>
                    <div class="timeline-info">
                        <span id="mapTimelineDate"></span>
                        <span id="mapTimelineChanges" class="changes"></span>
                        <span class="commit" id="mapTimelineCommit"></span>
                    </div>
                </div>
            `;

            renderMapScreens();
            renderMapConnections();
            setupMapControls();
            updateMapTransform();
            updateMapTimeline();
        }

        function layoutScreensForMap() {
            const SCREEN_WIDTH = 280;
            const SCREEN_HEIGHT = 600;
            const H_PADDING = 80;
            const V_PADDING = 120;
            const groups = MANIFEST.groups || {};

            // Build reverse flow map (who flows TO this screen)
            const incomingFlows = {};
            for (const [screenId, screen] of Object.entries(MANIFEST.screens)) {
                if (!incomingFlows[screenId]) incomingFlows[screenId] = [];
                for (const targetId of (screen.flows_to || [])) {
                    if (!incomingFlows[targetId]) incomingFlows[targetId] = [];
                    incomingFlows[targetId].push(screenId);
                }
            }

            // Calculate depth for each screen (BFS from roots)
            const screenDepth = {};
            const screenGroup = {};

            // Map screens to their groups
            for (const [groupId, group] of Object.entries(groups)) {
                for (const screenId of (group.screens || [])) {
                    screenGroup[screenId] = { id: groupId, color: group.color, name: group.name };
                }
            }

            // Find root screens per group (first screen in each group, or screens with minimal incoming flows)
            const roots = [];
            for (const [groupId, group] of Object.entries(groups)) {
                const groupScreens = group.screens || [];
                if (groupScreens.length > 0) {
                    // Use first screen as root, or find one with no internal incoming flows
                    let root = groupScreens[0];
                    for (const screenId of groupScreens) {
                        const incoming = (incomingFlows[screenId] || []).filter(s => groupScreens.includes(s));
                        if (incoming.length === 0) {
                            root = screenId;
                            break;
                        }
                    }
                    roots.push({ screenId: root, groupId });
                }
            }

            // BFS to assign depths within each group
            for (const { screenId: rootId, groupId } of roots) {
                const group = groups[groupId];
                const groupScreens = new Set(group.screens || []);
                const queue = [{ id: rootId, depth: 0 }];
                const visited = new Set();

                while (queue.length > 0) {
                    const { id, depth } = queue.shift();
                    if (visited.has(id) || !groupScreens.has(id)) continue;
                    visited.add(id);
                    screenDepth[id] = depth;

                    const screen = MANIFEST.screens[id];
                    for (const targetId of (screen?.flows_to || [])) {
                        if (groupScreens.has(targetId) && !visited.has(targetId)) {
                            queue.push({ id: targetId, depth: depth + 1 });
                        }
                    }
                }

                // Assign depth 0 to any unvisited screens in group
                for (const screenId of groupScreens) {
                    if (screenDepth[screenId] === undefined) {
                        screenDepth[screenId] = 0;
                    }
                }
            }

            // Group screens by depth level within each group
            const groupLevels = {};
            for (const [groupId, group] of Object.entries(groups)) {
                groupLevels[groupId] = {};
                for (const screenId of (group.screens || [])) {
                    const depth = screenDepth[screenId] || 0;
                    if (!groupLevels[groupId][depth]) groupLevels[groupId][depth] = [];
                    groupLevels[groupId][depth].push(screenId);
                }
            }

            // Layout: Groups as columns, depth as rows (like an org chart)
            // Each group gets a column, screens flow top-to-bottom within
            const groupOrder = Object.keys(groups);
            const GROUP_GAP = 100;

            let groupX = 0;

            for (const groupId of groupOrder) {
                const group = groups[groupId];
                const levels = groupLevels[groupId];
                const maxDepth = Math.max(...Object.keys(levels).map(Number), 0);

                // Find max width needed for this group (widest level)
                let maxLevelWidth = 0;
                for (const [depth, screens] of Object.entries(levels)) {
                    maxLevelWidth = Math.max(maxLevelWidth, screens.length);
                }

                const groupWidth = Math.max(maxLevelWidth, 1) * (SCREEN_WIDTH + H_PADDING);

                // Position screens - each depth level is a row
                for (const [depth, screens] of Object.entries(levels)) {
                    const levelY = parseInt(depth) * (SCREEN_HEIGHT + V_PADDING);
                    const levelWidth = screens.length * (SCREEN_WIDTH + H_PADDING) - H_PADDING;
                    const startX = groupX + (groupWidth - levelWidth) / 2;

                    screens.forEach((screenId, i) => {
                        screenPositions[screenId] = {
                            x: startX + i * (SCREEN_WIDTH + H_PADDING),
                            y: levelY,
                            width: SCREEN_WIDTH,
                            height: SCREEN_HEIGHT,
                            color: group.color
                        };
                    });
                }

                groupX += groupWidth + GROUP_GAP;
            }
        }

        function renderMapScreens() {
            const canvas = document.getElementById('mapCanvas');
            const captures = INDEX.captures || [];
            const currentCapture = captures[mapTimelineIdx];
            const captureId = currentCapture ? currentCapture.id : selectedCapture;

            for (const [screenId, screen] of Object.entries(MANIFEST.screens)) {
                const pos = screenPositions[screenId];
                if (!pos) continue;

                const div = document.createElement('div');
                div.className = 'map-screen';
                div.id = `map-screen-${screenId}`;
                div.dataset.screenId = screenId;
                div.dataset.groupColor = pos.color;
                div.style.cssText = `left:${pos.x}px; top:${pos.y}px; width:${pos.width}px; border-color:${pos.color}`;
                div.onclick = () => openModal(screenId, captureId);
                div.innerHTML = `
                    <img src="${CAPTURES_DIR}/${captureId}/${screenId}.png"
                         data-screen-id="${screenId}"
                         onerror="this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%22280%22 height=%22560%22><rect fill=%22%23161b22%22 width=%22280%22 height=%22560%22/><text x=%22140%22 y=%22280%22 fill=%22%238b949e%22 text-anchor=%22middle%22 font-family=%22system-ui%22 font-size=%2214%22>Not captured</text></svg>'">
                    <div class="screen-label">
                        <strong>${screen.name}</strong><br>
                        <span style="opacity: 0.7">${screenId}</span>
                    </div>
                `;
                canvas.appendChild(div);
            }
        }

        function renderMapConnections() {
            const svg = document.getElementById('mapConnections');
            let maxX = 0, maxY = 0;

            for (const pos of Object.values(screenPositions)) {
                maxX = Math.max(maxX, pos.x + pos.width);
                maxY = Math.max(maxY, pos.y + pos.height);
            }
            svg.setAttribute('width', maxX + 400);
            svg.setAttribute('height', maxY + 400);

            // Build connection map to detect bi-directional flows
            const flowMap = {};
            for (const [screenId, screen] of Object.entries(MANIFEST.screens)) {
                if (!screen.flows_to) continue;
                for (const targetId of screen.flows_to) {
                    const key = [screenId, targetId].sort().join('::');
                    if (!flowMap[key]) {
                        flowMap[key] = { screens: [screenId, targetId].sort(), directions: [] };
                    }
                    flowMap[key].directions.push({ from: screenId, to: targetId });
                }
            }

            // Collect unique connections (bi-directional merged)
            const connections = [];
            const processed = new Set();

            for (const [key, flow] of Object.entries(flowMap)) {
                if (processed.has(key)) continue;
                processed.add(key);

                const [screenA, screenB] = flow.screens;
                const posA = screenPositions[screenA];
                const posB = screenPositions[screenB];
                if (!posA || !posB) continue;

                const isBidirectional = flow.directions.length === 2;

                // Always draw from the higher screen to the lower screen
                const aIsHigher = posA.y < posB.y || (posA.y === posB.y && posA.x < posB.x);
                const fromScreen = aIsHigher ? screenA : screenB;
                const toScreen = aIsHigher ? screenB : screenA;
                const fromPos = aIsHigher ? posA : posB;
                const toPos = aIsHigher ? posB : posA;

                connections.push({
                    from: fromScreen,
                    to: toScreen,
                    fromPos,
                    toPos,
                    bidirectional: isBidirectional
                });
            }

            // Sort so longer connections draw first (behind shorter ones)
            connections.sort((a, b) => {
                const distA = Math.abs(a.toPos.x - a.fromPos.x) + Math.abs(a.toPos.y - a.fromPos.y);
                const distB = Math.abs(b.toPos.x - b.fromPos.x) + Math.abs(b.toPos.y - b.fromPos.y);
                return distB - distA;
            });

            // Draw connections
            connections.forEach(({ from: screenId, to: targetId, fromPos, toPos, bidirectional }) => {
                // Exit from bottom center of source
                const fromX = fromPos.x + fromPos.width / 2;
                const fromY = fromPos.y + fromPos.height;

                // Enter at top center of destination
                const toX = toPos.x + toPos.width / 2;
                const toY = toPos.y;

                const dx = toX - fromX;
                const dy = toY - fromY;

                const dropDistance = 50;
                const approachDistance = 40;

                let pathD;

                if (Math.abs(dx) < 50 && dy > 100) {
                    // Nearly vertical, target below - simple S curve
                    pathD = `M ${fromX} ${fromY}
                             C ${fromX} ${fromY + dy * 0.5},
                               ${toX} ${toY - dy * 0.5},
                               ${toX} ${toY}`;
                } else {
                    // Horizontal distance - smooth curve
                    const midY = Math.max(fromY + dropDistance, toY - approachDistance);

                    pathD = `M ${fromX} ${fromY}
                             L ${fromX} ${fromY + dropDistance}
                             C ${fromX} ${midY},
                               ${toX} ${midY},
                               ${toX} ${toY - approachDistance}
                             L ${toX} ${toY}`;
                }

                const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
                path.setAttribute('d', pathD);
                path.setAttribute('class', 'connection' + (bidirectional ? ' bidirectional' : ''));
                path.dataset.from = screenId;
                path.dataset.to = targetId;
                svg.appendChild(path);

                // Arrow at destination (pointing down into target)
                const arrowDown = document.createElementNS('http://www.w3.org/2000/svg', 'polygon');
                arrowDown.setAttribute('points', `${toX},${toY} ${toX-7},${toY-14} ${toX+7},${toY-14}`);
                arrowDown.setAttribute('class', 'connection-arrow');
                arrowDown.dataset.from = screenId;
                arrowDown.dataset.to = targetId;
                svg.appendChild(arrowDown);

                // If bidirectional, add arrow at source too (pointing up out of source)
                if (bidirectional) {
                    const arrowUp = document.createElementNS('http://www.w3.org/2000/svg', 'polygon');
                    arrowUp.setAttribute('points', `${fromX},${fromY} ${fromX-7},${fromY+14} ${fromX+7},${fromY+14}`);
                    arrowUp.setAttribute('class', 'connection-arrow');
                    arrowUp.dataset.from = targetId;
                    arrowUp.dataset.to = screenId;
                    svg.appendChild(arrowUp);
                }
            });
        }

        // Touch state for pinch-to-zoom
        let lastTouchDistance = 0;
        let lastTouchCenter = { x: 0, y: 0 };
        let isTouching = false;

        function setupMapControls() {
            const container = document.getElementById('mapContainer');

            // Mouse events for desktop
            container.addEventListener('mousedown', (e) => {
                if (e.target.closest('.map-screen')) return;
                isDragging = true;
                dragStartX = e.clientX - mapTranslateX;
                dragStartY = e.clientY - mapTranslateY;
            });

            container.addEventListener('mousemove', (e) => {
                if (!isDragging) return;
                mapTranslateX = e.clientX - dragStartX;
                mapTranslateY = e.clientY - dragStartY;
                updateMapTransform();
            });

            container.addEventListener('mouseup', () => isDragging = false);
            container.addEventListener('mouseleave', () => isDragging = false);

            // Mouse wheel zoom
            container.addEventListener('wheel', (e) => {
                e.preventDefault();
                const rect = container.getBoundingClientRect();
                const mouseX = e.clientX - rect.left;
                const mouseY = e.clientY - rect.top;
                const pointX = (mouseX - mapTranslateX) / mapScale;
                const pointY = (mouseY - mapTranslateY) / mapScale;
                mapScale *= e.deltaY > 0 ? 0.9 : 1.1;
                mapScale = Math.max(0.1, Math.min(3, mapScale));
                mapTranslateX = mouseX - pointX * mapScale;
                mapTranslateY = mouseY - pointY * mapScale;
                updateMapTransform();
            }, { passive: false });

            // Touch events for mobile
            container.addEventListener('touchstart', (e) => {
                if (e.target.closest('.map-screen')) return;
                if (e.touches.length === 1) {
                    isTouching = true;
                    isDragging = true;
                    dragStartX = e.touches[0].clientX - mapTranslateX;
                    dragStartY = e.touches[0].clientY - mapTranslateY;
                } else if (e.touches.length === 2) {
                    e.preventDefault();
                    isDragging = false;
                    lastTouchDistance = getTouchDistance(e.touches);
                    lastTouchCenter = getTouchCenter(e.touches, container);
                }
            }, { passive: false });

            container.addEventListener('touchmove', (e) => {
                if (e.touches.length === 1 && isDragging) {
                    mapTranslateX = e.touches[0].clientX - dragStartX;
                    mapTranslateY = e.touches[0].clientY - dragStartY;
                    updateMapTransform();
                } else if (e.touches.length === 2) {
                    e.preventDefault();
                    const newDistance = getTouchDistance(e.touches);
                    const newCenter = getTouchCenter(e.touches, container);
                    if (lastTouchDistance > 0) {
                        const scaleDelta = newDistance / lastTouchDistance;
                        const pointX = (lastTouchCenter.x - mapTranslateX) / mapScale;
                        const pointY = (lastTouchCenter.y - mapTranslateY) / mapScale;
                        mapScale *= scaleDelta;
                        mapScale = Math.max(0.1, Math.min(3, mapScale));
                        mapTranslateX = newCenter.x - pointX * mapScale;
                        mapTranslateY = newCenter.y - pointY * mapScale;
                        updateMapTransform();
                    }
                    lastTouchDistance = newDistance;
                    lastTouchCenter = newCenter;
                }
            }, { passive: false });

            container.addEventListener('touchend', (e) => {
                if (e.touches.length === 0) {
                    isDragging = false;
                    isTouching = false;
                    lastTouchDistance = 0;
                } else if (e.touches.length === 1) {
                    isDragging = true;
                    dragStartX = e.touches[0].clientX - mapTranslateX;
                    dragStartY = e.touches[0].clientY - mapTranslateY;
                }
            });
        }

        function getTouchDistance(touches) {
            const dx = touches[0].clientX - touches[1].clientX;
            const dy = touches[0].clientY - touches[1].clientY;
            return Math.sqrt(dx * dx + dy * dy);
        }

        function getTouchCenter(touches, container) {
            const rect = container.getBoundingClientRect();
            return {
                x: ((touches[0].clientX + touches[1].clientX) / 2) - rect.left,
                y: ((touches[0].clientY + touches[1].clientY) / 2) - rect.top
            };
        }

        function updateMapTransform() {
            const canvas = document.getElementById('mapCanvas');
            if (canvas) {
                canvas.style.transform = `translate(${mapTranslateX}px, ${mapTranslateY}px) scale(${mapScale})`;
            }
        }

        // Map Timeline Functions
        function mapRewind() {
            mapTimelineIdx = 0;
            updateMapTimeline();
        }

        function mapTogglePlay() {
            mapIsPlaying = !mapIsPlaying;
            const btn = document.getElementById('mapPlayBtn');
            if (btn) {
                btn.innerHTML = mapIsPlaying ? '⏸ Pause' : '▶ Play';
                btn.classList.toggle('active', mapIsPlaying);
            }
            if (mapIsPlaying) {
                mapPlayLoop();
            } else if (mapPlaybackTimer) {
                clearTimeout(mapPlaybackTimer);
                mapPlaybackTimer = null;
            }
        }

        function mapPlayLoop() {
            if (!mapIsPlaying) return;
            const captures = INDEX.captures || [];
            if (mapTimelineIdx < captures.length - 1) {
                mapTimelineIdx++;
                updateMapTimeline();
                mapPlaybackTimer = setTimeout(mapPlayLoop, mapPlaybackSpeed);
            } else {
                // Reached end
                mapIsPlaying = false;
                const btn = document.getElementById('mapPlayBtn');
                if (btn) {
                    btn.innerHTML = '▶ Play';
                    btn.classList.remove('active');
                }
            }
        }

        function mapStep() {
            const captures = INDEX.captures || [];
            if (mapTimelineIdx < captures.length - 1) {
                mapTimelineIdx++;
                updateMapTimeline();
            }
        }

        function mapJumpTo(idx) {
            mapTimelineIdx = idx;
            updateMapTimeline();
        }

        function mapSetSpeed(ms) {
            mapPlaybackSpeed = parseInt(ms);
        }

        function mapTrackClick(event) {
            const track = document.getElementById('mapTrack');
            const rect = track.getBoundingClientRect();
            const clickX = event.clientX - rect.left;
            const percent = clickX / rect.width;
            const captures = INDEX.captures || [];
            mapTimelineIdx = Math.round(percent * (captures.length - 1));
            updateMapTimeline();
        }

        function updateMapTimeline() {
            const captures = INDEX.captures || [];
            if (captures.length === 0) return;

            const currentCapture = captures[mapTimelineIdx];
            const prevCapture = mapTimelineIdx > 0 ? captures[mapTimelineIdx - 1] : null;

            // Update progress bar
            const progress = document.getElementById('mapProgress');
            if (progress) {
                const percent = captures.length > 1 ? (mapTimelineIdx / (captures.length - 1)) * 100 : 100;
                progress.style.width = `${percent}%`;
            }

            // Update markers
            document.querySelectorAll('.timeline-marker').forEach((marker, i) => {
                marker.classList.toggle('active', i === mapTimelineIdx);
            });

            // Update info text
            const dateEl = document.getElementById('mapTimelineDate');
            const commitEl = document.getElementById('mapTimelineCommit');
            const changesEl = document.getElementById('mapTimelineChanges');

            if (dateEl) dateEl.textContent = new Date(currentCapture.timestamp).toLocaleDateString() + ' ' + new Date(currentCapture.timestamp).toLocaleTimeString();
            if (commitEl) commitEl.textContent = currentCapture.commit;

            // Update screenshot images
            document.querySelectorAll('.map-screen img[data-screen-id]').forEach(img => {
                const screenId = img.dataset.screenId;
                img.src = `${CAPTURES_DIR}/${currentCapture.id}/${screenId}.png`;
            });

            // Determine changed screens (compare to previous capture)
            const changedScreens = new Set();
            const newScreens = new Set();

            if (prevCapture) {
                // Get change threshold from manifest (default 0.5%)
                const changeThreshold = MANIFEST.changeThreshold || 0.5;

                // Get visual change data (from ImageMagick) and source changes (from git)
                const captureChangeData = INDEX.changeData?.[currentCapture.id] || {};
                const captureSourceChanges = INDEX.sourceChanges?.[currentCapture.id] || [];

                // Check each screen for changes
                Object.keys(MANIFEST.screens).forEach(screenId => {
                    const visualPct = captureChangeData[screenId];
                    const sourceChanged = captureSourceChanges.includes(screenId);

                    // A screen is "changed" if:
                    // 1. Source file changed AND visual change exceeds threshold (confirmed change)
                    // 2. OR visual change is significant (>threshold) even without source change
                    //    (could be indirect change from shared components/styles)
                    if (sourceChanged && visualPct !== undefined && visualPct > changeThreshold) {
                        // Confirmed change: both source and visual
                        changedScreens.add(screenId);
                    } else if (visualPct !== undefined && visualPct > changeThreshold) {
                        // Visual-only change (indirect/shared component change)
                        changedScreens.add(screenId);
                    } else if (sourceChanged && (visualPct === undefined || visualPct <= changeThreshold)) {
                        // Source changed but no significant visual change
                        // Could be refactoring or non-visual code change - don't highlight
                    } else if (!INDEX.changeData && (currentCapture.mode === 'smart' || currentCapture.mode === 'specific')) {
                        // Fallback: no change data at all, but smart mode - assume changed
                        changedScreens.add(screenId);
                    }
                });
            }

            // Apply visual states to map screens
            let changeCount = 0;
            document.querySelectorAll('.map-screen').forEach(screenDiv => {
                const screenId = screenDiv.dataset.screenId;
                const groupColor = screenDiv.dataset.groupColor;

                screenDiv.classList.remove('faded', 'changed', 'new-screen');

                if (mapTimelineIdx === 0 || showAllScreens) {
                    // First capture or show all mode - show all normally
                    screenDiv.style.borderColor = groupColor;
                    // Still track changes for the count
                    if (newScreens.has(screenId)) changeCount++;
                    else if (changedScreens.has(screenId)) changeCount++;
                } else if (newScreens.has(screenId)) {
                    screenDiv.classList.add('new-screen');
                    changeCount++;
                } else if (changedScreens.has(screenId)) {
                    screenDiv.classList.add('changed');
                    changeCount++;
                } else {
                    // Unchanged - fade it
                    screenDiv.classList.add('faded');
                    screenDiv.style.borderColor = groupColor;
                }
            });

            if (changesEl) {
                if (mapTimelineIdx === 0) {
                    changesEl.textContent = 'Baseline capture';
                } else if (changeCount > 0) {
                    changesEl.textContent = `${changeCount} screen${changeCount === 1 ? '' : 's'} changed`;
                } else {
                    changesEl.textContent = '';
                }
            }
        }

        function openModal(screenId, captureId = selectedCapture) {
            const screen = MANIFEST.screens[screenId];
            if (!screen) return;

            document.getElementById('modalImg').src = `${CAPTURES_DIR}/${captureId}/${screenId}.png`;
            document.getElementById('modalTitle').textContent = screen.name;
            document.getElementById('modalId').textContent = screenId;

            const flowsHtml = (screen.flows_to || [])
                .map(id => `<li><a href="#" onclick="openModal('${id}'); return false;">${MANIFEST.screens[id]?.name || id}</a></li>`)
                .join('') || '<li>None</li>';
            document.getElementById('modalFlows').innerHTML = flowsHtml;

            const sourcesHtml = (screen.sources || [])
                .map(s => `<li>${s.split('/').pop()}</li>`)
                .join('') || '<li>None</li>';
            document.getElementById('modalSources').innerHTML = sourcesHtml;

            // Render screen evolution filmstrip
            currentModalScreen = screenId;
            renderScreenEvolution(screenId, captureId);

            // Render mini-map
            renderMiniMap(screenId, captureId);

            document.getElementById('modal').classList.add('active');
        }

        function renderScreenEvolution(screenId, initialCaptureId) {
            const filmstrip = document.getElementById('evolutionFilmstrip');
            const counter = document.getElementById('evoCounter');
            const threshold = MANIFEST.changeThreshold || 0.5;

            stopEvolutionPlay();

            document.getElementById('evoChangesBtn').classList.toggle('active', !evolutionShowAll);
            document.getElementById('evoAllBtn').classList.toggle('active', evolutionShowAll);

            const allCaptures = INDEX.captures.filter(c => c.screenCount > 0);

            if (allCaptures.length === 0) {
                filmstrip.innerHTML = '<div class="evolution-empty">No captures available</div>';
                counter.textContent = '0 / 0';
                evolutionCaptures = [];
                return;
            }

            const changedCaptureIds = new Set();
            allCaptures.forEach((capture, idx) => {
                if (idx === 0) return;
                const changeData = INDEX.changeData?.[capture.id] || {};
                const changePct = changeData[screenId];
                if (changePct !== undefined && changePct > threshold) {
                    changedCaptureIds.add(capture.id);
                }
            });

            if (evolutionShowAll) {
                evolutionCaptures = allCaptures;
            } else {
                evolutionCaptures = allCaptures.filter((c, idx) =>
                    idx === 0 || changedCaptureIds.has(c.id)
                );
            }

            if (evolutionCaptures.length === 0) {
                filmstrip.innerHTML = '<div class="evolution-empty">No changes detected for this screen</div>';
                counter.textContent = '0 changes';
                return;
            }

            evolutionIdx = evolutionCaptures.findIndex(c => c.id === initialCaptureId);
            if (evolutionIdx < 0) evolutionIdx = evolutionCaptures.length - 1;

            filmstrip.innerHTML = evolutionCaptures.map((capture, idx) => {
                const isChanged = changedCaptureIds.has(capture.id);
                const isActive = idx === evolutionIdx;
                const changeData = INDEX.changeData?.[capture.id] || {};
                const changePct = changeData[screenId];
                const isBaseline = allCaptures.indexOf(capture) === 0;

                return `
                    <div class="evolution-frame ${isActive ? 'active' : ''} ${isChanged ? 'changed' : ''}"
                         onclick="selectEvolutionFrame(${idx})"
                         data-idx="${idx}">
                        <img src="${CAPTURES_DIR}/${capture.id}/${screenId}.png"
                             onerror="this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2280%22 height=%22140%22><rect fill=%22%23161b22%22 width=%2280%22 height=%22140%22/></svg>'">
                        <div class="frame-info">
                            <div class="commit">${isBaseline ? 'baseline' : capture.commit}</div>
                            ${isChanged && changePct ? `<div class="change-pct">${changePct.toFixed(1)}%</div>` : ''}
                        </div>
                    </div>
                `;
            }).join('');

            const changedCount = changedCaptureIds.size;
            if (evolutionShowAll) {
                counter.textContent = `${evolutionIdx + 1} / ${evolutionCaptures.length} (${changedCount} changes)`;
            } else {
                counter.textContent = `${evolutionIdx + 1} / ${evolutionCaptures.length} changes`;
            }

            setTimeout(() => {
                const activeFrame = filmstrip.querySelector('.evolution-frame.active');
                if (activeFrame) {
                    activeFrame.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
                }
            }, 100);
        }

        function setEvolutionFilter(showAll) {
            evolutionShowAll = showAll;
            if (currentModalScreen) {
                renderScreenEvolution(currentModalScreen, evolutionCaptures[evolutionIdx]?.id);
            }
        }

        function selectEvolutionFrame(idx) {
            if (idx < 0 || idx >= evolutionCaptures.length) return;

            evolutionIdx = idx;
            const capture = evolutionCaptures[idx];

            document.getElementById('modalImg').src = `${CAPTURES_DIR}/${capture.id}/${currentModalScreen}.png`;

            document.querySelectorAll('.evolution-frame').forEach((frame, i) => {
                frame.classList.toggle('active', i === idx);
            });

            const counter = document.getElementById('evoCounter');
            if (evolutionShowAll) {
                const threshold = MANIFEST.changeThreshold || 0.5;
                const changedCount = evolutionCaptures.filter((c, i) => {
                    if (i === 0) return false;
                    const changeData = INDEX.changeData?.[c.id] || {};
                    const changePct = changeData[currentModalScreen];
                    return changePct !== undefined && changePct > threshold;
                }).length;
                counter.textContent = `${idx + 1} / ${evolutionCaptures.length} (${changedCount} changes)`;
            } else {
                counter.textContent = `${idx + 1} / ${evolutionCaptures.length} changes`;
            }

            const filmstrip = document.getElementById('evolutionFilmstrip');
            const activeFrame = filmstrip.querySelector('.evolution-frame.active');
            if (activeFrame) {
                activeFrame.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
            }
        }

        function toggleEvolutionPlay() {
            if (evolutionIsPlaying) {
                stopEvolutionPlay();
            } else {
                startEvolutionPlay();
            }
        }

        function startEvolutionPlay() {
            evolutionIsPlaying = true;
            const playBtn = document.getElementById('evoPlayBtn');
            playBtn.textContent = '⏸ Pause';
            playBtn.classList.add('active');

            if (evolutionIdx >= evolutionCaptures.length - 1) {
                evolutionIdx = -1;
            }

            evolutionTimer = setInterval(() => {
                evolutionIdx++;
                if (evolutionIdx >= evolutionCaptures.length) {
                    stopEvolutionPlay();
                    return;
                }
                selectEvolutionFrame(evolutionIdx);
            }, 500);
        }

        function stopEvolutionPlay() {
            evolutionIsPlaying = false;
            if (evolutionTimer) {
                clearInterval(evolutionTimer);
                evolutionTimer = null;
            }
            const playBtn = document.getElementById('evoPlayBtn');
            if (playBtn) {
                playBtn.textContent = '▶ Play';
                playBtn.classList.remove('active');
            }
        }

        function renderMiniMap(screenId, captureId) {
            const canvas = document.getElementById('miniMapCanvas');
            const svg = document.getElementById('miniMapSvg');
            const screen = MANIFEST.screens[screenId];

            // Clear previous content (except SVG)
            canvas.querySelectorAll('.mini-screen').forEach(el => el.remove());
            svg.innerHTML = '';

            // Find incoming and outgoing connections
            const outgoing = screen.flows_to || [];
            const incoming = [];

            for (const [otherId, otherScreen] of Object.entries(MANIFEST.screens)) {
                if (otherId !== screenId && (otherScreen.flows_to || []).includes(screenId)) {
                    incoming.push(otherId);
                }
            }

            // Determine bidirectional
            const bidirectional = outgoing.filter(id => incoming.includes(id));
            const outgoingOnly = outgoing.filter(id => !bidirectional.includes(id));
            const incomingOnly = incoming.filter(id => !bidirectional.includes(id));

            // Layout: current screen in center, incoming on left, outgoing on right, bidirectional on top/bottom
            const centerX = 180;
            const centerY = 100;
            const currentWidth = 70;
            const currentHeight = 120;
            const miniWidth = 50;
            const miniHeight = 85;
            const spacing = 50;

            // Add current screen (center)
            const currentDiv = document.createElement('div');
            currentDiv.className = 'mini-screen current';
            currentDiv.style.left = `${centerX - currentWidth / 2}px`;
            currentDiv.style.top = `${centerY - currentHeight / 2}px`;
            currentDiv.innerHTML = `<img src="${CAPTURES_DIR}/${captureId}/${screenId}.png" style="width:100%;height:100%;object-fit:cover;border-radius:2px;" onerror="this.style.display='none'">`;
            canvas.appendChild(currentDiv);

            const positions = {};

            // Helper to add hover handlers
            function addHoverHandlers(div, id) {
                div.addEventListener('mouseenter', () => {
                    canvas.classList.add('has-hover');
                    div.classList.add('hover-target');
                    // Highlight the connection for this screen
                    svg.querySelectorAll(`.mini-connection[data-screen="${id}"]`).forEach(conn => {
                        conn.classList.add('hover-active');
                    });
                });
                div.addEventListener('mouseleave', () => {
                    canvas.classList.remove('has-hover');
                    div.classList.remove('hover-target');
                    svg.querySelectorAll('.mini-connection.hover-active').forEach(conn => {
                        conn.classList.remove('hover-active');
                    });
                });
            }

            // Position incoming screens on the left
            incomingOnly.forEach((id, i) => {
                const total = incomingOnly.length;
                const offsetY = centerY - ((total - 1) * (miniHeight + 10)) / 2;
                const x = 20;
                const y = offsetY + i * (miniHeight + 10) - miniHeight / 2;
                // Store the actual div position (top-left corner)
                positions[id] = { left: x, top: y, type: 'incoming' };

                const div = document.createElement('div');
                div.className = 'mini-screen incoming';
                div.style.left = `${x}px`;
                div.style.top = `${y}px`;
                div.onclick = () => openModal(id, captureId);
                div.title = MANIFEST.screens[id]?.name || id;
                div.innerHTML = `<img src="${CAPTURES_DIR}/${captureId}/${id}.png" style="width:100%;height:100%;object-fit:cover;border-radius:4px;" onerror="this.style.display='none'">`;
                addHoverHandlers(div, id);
                canvas.appendChild(div);
            });

            // Position outgoing screens on the right
            outgoingOnly.forEach((id, i) => {
                const total = outgoingOnly.length;
                const offsetY = centerY - ((total - 1) * (miniHeight + 10)) / 2;
                const x = 290;
                const y = offsetY + i * (miniHeight + 10) - miniHeight / 2;
                positions[id] = { left: x, top: y, type: 'outgoing' };

                const div = document.createElement('div');
                div.className = 'mini-screen outgoing';
                div.style.left = `${x}px`;
                div.style.top = `${y}px`;
                div.onclick = () => openModal(id, captureId);
                div.title = MANIFEST.screens[id]?.name || id;
                div.innerHTML = `<img src="${CAPTURES_DIR}/${captureId}/${id}.png" style="width:100%;height:100%;object-fit:cover;border-radius:4px;" onerror="this.style.display='none'">`;
                addHoverHandlers(div, id);
                canvas.appendChild(div);
            });

            // Position bidirectional screens on top and bottom
            bidirectional.forEach((id, i) => {
                const isTop = i % 2 === 0;
                const col = Math.floor(i / 2);
                const x = centerX + (col - Math.floor(bidirectional.length / 4)) * (miniWidth + 15) - miniWidth / 2;
                const y = isTop ? 5 : 175;
                positions[id] = { left: x, top: y, type: 'bidirectional' };

                const div = document.createElement('div');
                div.className = 'mini-screen bidirectional';
                div.style.left = `${x}px`;
                div.style.top = `${y}px`;
                div.onclick = () => openModal(id, captureId);
                div.title = MANIFEST.screens[id]?.name || id;
                div.innerHTML = `<img src="${CAPTURES_DIR}/${captureId}/${id}.png" style="width:100%;height:100%;object-fit:cover;border-radius:4px;" onerror="this.style.display='none'">`;
                addHoverHandlers(div, id);
                canvas.appendChild(div);
            });

            // Draw connections using actual screen positions
            svg.setAttribute('width', '600');
            svg.setAttribute('height', '400');

            // Current screen edges
            const currentLeft = centerX - currentWidth / 2;
            const currentRight = centerX + currentWidth / 2;
            const currentTop = centerY - currentHeight / 2;
            const currentBottom = centerY + currentHeight / 2;

            for (const [id, pos] of Object.entries(positions)) {
                const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
                let d;

                // Calculate screen center and edges from stored position
                const screenCenterX = pos.left + miniWidth / 2;
                const screenCenterY = pos.top + miniHeight / 2;
                const screenRight = pos.left + miniWidth;
                const screenLeft = pos.left;
                const screenTop = pos.top;
                const screenBottom = pos.top + miniHeight;

                if (pos.type === 'incoming') {
                    // Curve from right edge of incoming screen to left edge of current
                    const startX = screenRight;
                    const startY = screenCenterY;
                    const endX = currentLeft;
                    const endY = centerY;
                    const ctrlX = (startX + endX) / 2;
                    d = `M ${startX} ${startY} C ${ctrlX} ${startY}, ${ctrlX} ${endY}, ${endX} ${endY}`;
                } else if (pos.type === 'outgoing') {
                    // Curve from right edge of current to left edge of outgoing screen
                    const startX = currentRight;
                    const startY = centerY;
                    const endX = screenLeft;
                    const endY = screenCenterY;
                    const ctrlX = (startX + endX) / 2;
                    d = `M ${startX} ${startY} C ${ctrlX} ${startY}, ${ctrlX} ${endY}, ${endX} ${endY}`;
                } else {
                    // Bidirectional - vertical curve
                    const isTop = screenCenterY < centerY;
                    if (isTop) {
                        const startY = screenBottom;
                        const endY = currentTop;
                        const midY = (startY + endY) / 2;
                        d = `M ${screenCenterX} ${startY} C ${screenCenterX} ${midY}, ${centerX} ${midY}, ${centerX} ${endY}`;
                    } else {
                        const startY = currentBottom;
                        const endY = screenTop;
                        const midY = (startY + endY) / 2;
                        d = `M ${centerX} ${startY} C ${centerX} ${midY}, ${screenCenterX} ${midY}, ${screenCenterX} ${endY}`;
                    }
                }

                path.setAttribute('d', d);
                path.setAttribute('class', `mini-connection ${pos.type}`);
                path.setAttribute('data-screen', id);
                svg.appendChild(path);
            }

            // Reset pan position and initialize panning
            miniMapPanX = 0;
            miniMapPanY = 0;
            canvas.style.transform = `translate(${miniMapPanX}px, ${miniMapPanY}px)`;
            initMiniMapPanning();
        }

        let miniMapPanningInitialized = false;
        function initMiniMapPanning() {
            if (miniMapPanningInitialized) return;
            miniMapPanningInitialized = true;

            const canvas = document.getElementById('miniMapCanvas');

            // Mouse events
            canvas.addEventListener('mousedown', onMiniMapPanStart);
            document.addEventListener('mousemove', onMiniMapPanMove);
            document.addEventListener('mouseup', onMiniMapPanEnd);

            // Touch events
            canvas.addEventListener('touchstart', onMiniMapTouchStart, { passive: false });
            document.addEventListener('touchmove', onMiniMapTouchMove, { passive: false });
            document.addEventListener('touchend', onMiniMapPanEnd);
        }

        function onMiniMapPanStart(e) {
            // Only pan on direct canvas click or if not clicking a mini-screen
            if (e.target.classList.contains('mini-screen') || e.target.closest('.mini-screen')) {
                return;
            }
            miniMapIsPanning = true;
            miniMapStartX = e.clientX - miniMapPanX;
            miniMapStartY = e.clientY - miniMapPanY;
            document.getElementById('miniMapCanvas').classList.add('panning');
            e.preventDefault();
        }

        function onMiniMapTouchStart(e) {
            if (e.target.classList.contains('mini-screen') || e.target.closest('.mini-screen')) {
                return;
            }
            if (e.touches.length === 1) {
                miniMapIsPanning = true;
                miniMapStartX = e.touches[0].clientX - miniMapPanX;
                miniMapStartY = e.touches[0].clientY - miniMapPanY;
                document.getElementById('miniMapCanvas').classList.add('panning');
                e.preventDefault();
            }
        }

        function onMiniMapPanMove(e) {
            if (!miniMapIsPanning) return;
            miniMapPanX = e.clientX - miniMapStartX;
            miniMapPanY = e.clientY - miniMapStartY;
            document.getElementById('miniMapCanvas').style.transform = `translate(${miniMapPanX}px, ${miniMapPanY}px)`;
        }

        function onMiniMapTouchMove(e) {
            if (!miniMapIsPanning) return;
            if (e.touches.length === 1) {
                miniMapPanX = e.touches[0].clientX - miniMapStartX;
                miniMapPanY = e.touches[0].clientY - miniMapPanY;
                document.getElementById('miniMapCanvas').style.transform = `translate(${miniMapPanX}px, ${miniMapPanY}px)`;
                e.preventDefault();
            }
        }

        function onMiniMapPanEnd() {
            miniMapIsPanning = false;
            const canvas = document.getElementById('miniMapCanvas');
            if (canvas) canvas.classList.remove('panning');
        }

        function closeModal() {
            stopEvolutionPlay();
            document.getElementById('modal').classList.remove('active');
        }

        init();
    </script>
</body>
</html>
HTMLDOC

# Inject the JSON data
# Escape special sed characters in JSON (& is special in sed replacement)
MANIFEST_ESCAPED=$(echo "$MANIFEST_JSON" | jq -c '.' | sed 's/&/\\&/g')
INDEX_ESCAPED=$(echo "$INDEX_JSON" | jq -c '.' | sed 's/&/\\&/g')

TEMP_FILE=$(mktemp)
sed "s|__MANIFEST_JSON__|${MANIFEST_ESCAPED}|g" "$OUTPUT_FILE" > "$TEMP_FILE"
mv "$TEMP_FILE" "$OUTPUT_FILE"

TEMP_FILE=$(mktemp)
sed "s|__INDEX_JSON__|${INDEX_ESCAPED}|g" "$OUTPUT_FILE" > "$TEMP_FILE"
mv "$TEMP_FILE" "$OUTPUT_FILE"

echo ""
echo -e "${GREEN}=== Viewer Generated ===${NC}"
echo ""
echo "Output: $OUTPUT_FILE"
echo ""
echo "Modes:"
echo "  - Single:    View any capture"
echo "  - Compare:   Side-by-side diff"
echo "  - Timelapse: Scrub through timeline"
echo "  - Map:       App flow visualization"
echo ""

# Exit early if generate-only mode
if [ "$GENERATE_ONLY" = true ]; then
    exit 0
fi

# Count captures
CAPTURE_COUNT=$(echo "$INDEX_JSON" | jq '.captures | length' 2>/dev/null || echo "0")

# Contextual next steps
echo -e "${CYAN}What's next?${NC}"
if [ "$CAPTURE_COUNT" -lt 2 ]; then
    echo "  Build your timeline:"
    echo "    1. Make changes to your app"
    echo "    2. ${GREEN}darwin capture${NC}              # Add to timeline"
    echo "    3. ${GREEN}darwin viewer${NC}               # See evolution"
else
    echo "  Keep evolving:"
    echo "    ${GREEN}darwin capture${NC}                # After making changes"
    echo "    ${GREEN}darwin diff${NC}                   # Quick CLI comparison"
    echo ""
    echo "  Automate captures:"
    echo "    ${GREEN}darwin hook install${NC}           # Auto-capture on commit"
fi

echo ""
echo "Opening viewer..."
open "$OUTPUT_FILE"
echo ""
echo -e "${GREEN}🧬 Done${NC}"
