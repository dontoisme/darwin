#!/bin/bash
#
# darwin-capture
#
# Smart screenshot capture for iOS apps.
# Detects which screens changed based on git diff and only captures those.
#
# Usage:
#   darwin capture                    # Smart capture (changed screens only)
#   darwin capture --baseline         # Capture ALL screens (first run)
#   darwin capture --all              # Force capture all screens
#   darwin capture --dry-run          # Show what would be captured
#   darwin capture --screens 14,21    # Capture specific screens
#

set -e

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
LIB_DIR="$SCRIPT_DIR/../lib"

# Source configuration
source "$LIB_DIR/config.sh"

# Source webhook notifications
source "$LIB_DIR/webhooks.sh"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Parse arguments first to handle --help before config loading
for arg in "$@"; do
    case "$arg" in
        --help|-h)
            echo "Usage: darwin capture [OPTIONS]"
            echo ""
            echo "Options:"
            echo "  --baseline       Capture ALL screens (for first run)"
            echo "  --all            Force capture all screens"
            echo "  --dry-run        Show what would be captured without running"
            echo "  --screens IDS    Capture specific screens (comma-separated, e.g., 14,21)"
            echo "  --project FILE   Override project file"
            echo "  --scheme NAME    Override scheme name"
            echo "  --destination D  Override simulator destination"
            echo "  --help           Show this help message"
            echo ""
            echo "Default: Smart capture - only screens with changed source files"
            exit 0
            ;;
    esac
done

# Load configuration
if ! load_config; then
    echo -e "${RED}Error: darwin.json not found.${NC}"
    echo "Run 'darwin init' to set up your project, or create darwin.json manually."
    exit 1
fi

# New folder structure paths
CAPTURES_DIR="$CONFIG_OUTPUT_PATH/captures"
INDEX_FILE="$CONFIG_OUTPUT_PATH/index.json"

# Check manifest sync status (quick check, non-blocking)
check_manifest_sync() {
    if [ -f "$SCRIPT_DIR/darwin-manifest" ]; then
        # Quick sync check - count missing tests
        local test_file="$PROJECT_DIR/$CONFIG_TEST_TARGET/$CONFIG_TEST_CLASS.swift"
        if [ -f "$test_file" ] && [ -f "$CONFIG_MANIFEST_PATH" ]; then
            local manifest_tests=$(jq -r '.screens[].test // empty' "$CONFIG_MANIFEST_PATH" 2>/dev/null | sort)
            local existing_tests=$(grep -oE 'func test[0-9]+_[a-zA-Z0-9_]+' "$test_file" 2>/dev/null | sed 's/func //' | sort)
            local missing=$(comm -23 <(echo "$manifest_tests") <(echo "$existing_tests") | wc -l | tr -d ' ')
            if [ "$missing" -gt 0 ]; then
                echo -e "${YELLOW}⚠ Manifest has $missing screen(s) without tests${NC}"
                echo -e "  Run: ${GREEN}darwin manifest sync --generate${NC}"
                echo ""
            fi
        fi
    fi
}
check_manifest_sync

# Get current git info
GIT_COMMIT=$(git -C "$PROJECT_DIR" rev-parse --short HEAD 2>/dev/null || echo "unknown")
GIT_COMMIT_FULL=$(git -C "$PROJECT_DIR" rev-parse HEAD 2>/dev/null || echo "unknown")
GIT_BRANCH=$(git -C "$PROJECT_DIR" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "unknown")
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
TIMESTAMP_ISO=$(date -u +%Y-%m-%dT%H:%M:%SZ)

echo -e "${BLUE}🧬 Darwin - Screenshot Capture${NC}"
echo "Project: $CONFIG_PROJECT"
echo "Commit: $GIT_COMMIT"
echo ""

# Parse arguments
MODE="smart"
DRY_RUN=false
SPECIFIC_SCREENS=""

while [[ $# -gt 0 ]]; do
    case "$1" in
        --baseline)
            MODE="baseline"
            shift
            ;;
        --all)
            MODE="all"
            shift
            ;;
        --dry-run)
            DRY_RUN=true
            shift
            ;;
        --screens)
            MODE="specific"
            SPECIFIC_SCREENS="$2"
            shift 2
            ;;
        --project)
            CONFIG_PROJECT="$2"
            CONFIG_PROJECT_PATH="$PROJECT_DIR/$2"
            shift 2
            ;;
        --scheme)
            CONFIG_SCHEME="$2"
            shift 2
            ;;
        --destination)
            CONFIG_DESTINATION="$2"
            shift 2
            ;;
        --help|-h)
            # Already handled above
            shift
            ;;
        *)
            echo -e "${RED}Unknown option: $1${NC}"
            exit 1
            ;;
    esac
done

# Validate configuration
if ! validate_config; then
    exit 1
fi

# Check for manifest
if [ ! -f "$CONFIG_MANIFEST_PATH" ]; then
    echo -e "${RED}Error: manifest.json not found at $CONFIG_MANIFEST_PATH${NC}"
    echo "Run with --baseline to create initial screenshots."
    exit 1
fi

# Initialize index.json if it doesn't exist
init_index() {
    if [ ! -f "$INDEX_FILE" ]; then
        mkdir -p "$CONFIG_OUTPUT_PATH"
        cat > "$INDEX_FILE" << EOF
{
  "version": "1.0",
  "captures": []
}
EOF
    fi
}

# Get the latest capture ID from index
get_latest_capture() {
    if [ -f "$INDEX_FILE" ]; then
        jq -r '.captures | last | .id // empty' "$INDEX_FILE" 2>/dev/null
    fi
}

# Get capture commit by ID
get_capture_commit() {
    local capture_id="$1"
    if [ -f "$INDEX_FILE" ]; then
        jq -r ".captures[] | select(.id == \"$capture_id\") | .commit" "$INDEX_FILE" 2>/dev/null
    fi
}

# Add capture to index
add_to_index() {
    local capture_id="$1"
    local parent_id="$2"
    local screen_count="$3"

    local new_entry=$(cat << EOF
{
  "id": "$capture_id",
  "commit": "$GIT_COMMIT",
  "commitFull": "$GIT_COMMIT_FULL",
  "branch": "$GIT_BRANCH",
  "timestamp": "$TIMESTAMP_ISO",
  "parent": $([ -n "$parent_id" ] && echo "\"$parent_id\"" || echo "null"),
  "screenCount": $screen_count,
  "mode": "$MODE"
}
EOF
)

    # Add to index using jq
    jq ".captures += [$new_entry]" "$INDEX_FILE" > "$INDEX_FILE.tmp" && mv "$INDEX_FILE.tmp" "$INDEX_FILE"
}

# Function to get screens affected by changed files
get_affected_screens() {
    local changed_files="$1"
    local affected_tests=""

    # Read manifest and find affected screens
    while IFS= read -r screen_id; do
        # Get sources for this screen
        local sources=$(jq -r ".screens[\"$screen_id\"].sources[]" "$CONFIG_MANIFEST_PATH" 2>/dev/null)
        local test_name=$(jq -r ".screens[\"$screen_id\"].test" "$CONFIG_MANIFEST_PATH" 2>/dev/null)

        # Check if any source file is in the changed files
        for source in $sources; do
            if echo "$changed_files" | grep -q "$source"; then
                if [ -n "$affected_tests" ]; then
                    affected_tests="$affected_tests,$test_name"
                else
                    affected_tests="$test_name"
                fi
                echo -e "  ${GREEN}→${NC} $screen_id (${source})" >&2
                break
            fi
        done
    done < <(jq -r '.screens | keys[]' "$CONFIG_MANIFEST_PATH")

    echo "$affected_tests"
}

# Initialize index
init_index

# Determine which screens to capture
TESTS_TO_RUN=""
CAPTURE_ID=""
PARENT_ID=""
OUTPUT_DIR=""

case "$MODE" in
    baseline)
        echo -e "${YELLOW}Mode: BASELINE (capturing all screens)${NC}"
        CAPTURE_ID="baseline"
        PARENT_ID=""
        OUTPUT_DIR="$CAPTURES_DIR/baseline"
        TESTS_TO_RUN="all"
        ;;
    all)
        echo -e "${YELLOW}Mode: ALL (forcing full capture)${NC}"
        CAPTURE_ID="$GIT_COMMIT"
        PARENT_ID=$(get_latest_capture)
        OUTPUT_DIR="$CAPTURES_DIR/$GIT_COMMIT"
        TESTS_TO_RUN="all"
        ;;
    specific)
        echo -e "${YELLOW}Mode: SPECIFIC (screens: $SPECIFIC_SCREENS)${NC}"
        CAPTURE_ID="$GIT_COMMIT"
        PARENT_ID=$(get_latest_capture)
        OUTPUT_DIR="$CAPTURES_DIR/$GIT_COMMIT"
        # Convert screen IDs to test names
        IFS=',' read -ra SCREEN_IDS <<< "$SPECIFIC_SCREENS"
        for id in "${SCREEN_IDS[@]}"; do
            # Pad with leading zero if needed
            padded_id=$(printf "%02d" "$id")
            # Find matching screen
            test_name=$(jq -r ".screens | to_entries[] | select(.key | startswith(\"$padded_id-\")) | .value.test" "$CONFIG_MANIFEST_PATH" 2>/dev/null | head -1)
            if [ -n "$test_name" ] && [ "$test_name" != "null" ]; then
                if [ -n "$TESTS_TO_RUN" ]; then
                    TESTS_TO_RUN="$TESTS_TO_RUN,$test_name"
                else
                    TESTS_TO_RUN="$test_name"
                fi
            fi
        done
        ;;
    smart)
        echo -e "${YELLOW}Mode: SMART (detecting changes)${NC}"
        CAPTURE_ID="$GIT_COMMIT"
        PARENT_ID=$(get_latest_capture)
        OUTPUT_DIR="$CAPTURES_DIR/$GIT_COMMIT"

        # Find what changed since last capture
        if [ -z "$PARENT_ID" ]; then
            echo -e "${RED}No previous captures found. Run with --baseline first.${NC}"
            exit 1
        fi

        PARENT_COMMIT=$(get_capture_commit "$PARENT_ID")

        if [ -z "$PARENT_COMMIT" ] || [ "$PARENT_COMMIT" == "null" ]; then
            echo -e "${RED}Could not determine parent commit. Run with --baseline first.${NC}"
            exit 1
        fi

        echo "Last capture: $PARENT_ID (commit: $PARENT_COMMIT)"
        echo "Current: $GIT_COMMIT"
        echo ""

        # Get changed Swift files
        CHANGED_FILES=$(git -C "$PROJECT_DIR" diff --name-only "$PARENT_COMMIT" HEAD -- '*.swift' 2>/dev/null || echo "")

        if [ -z "$CHANGED_FILES" ]; then
            echo -e "${GREEN}No Swift files changed since last capture.${NC}"
            exit 0
        fi

        echo "Changed files:"
        echo "$CHANGED_FILES" | while read -r file; do
            echo -e "  ${BLUE}•${NC} $file"
        done
        echo ""

        echo "Affected screens:"
        TESTS_TO_RUN=$(get_affected_screens "$CHANGED_FILES")

        if [ -z "$TESTS_TO_RUN" ]; then
            echo -e "${GREEN}No UI screens affected by changes.${NC}"
            exit 0
        fi
        ;;
esac

echo ""
echo -e "Output directory: ${BLUE}$OUTPUT_DIR${NC}"
echo ""

# Dry run - just show what would happen
if [ "$DRY_RUN" = true ]; then
    echo -e "${YELLOW}=== DRY RUN ===${NC}"
    if [ "$TESTS_TO_RUN" == "all" ]; then
        echo "Would run: ALL screenshot tests"
    else
        echo "Would run tests: $TESTS_TO_RUN"
    fi
    echo "Would save to: $OUTPUT_DIR"
    echo "Capture ID: $CAPTURE_ID"
    echo "Parent: ${PARENT_ID:-none}"
    exit 0
fi

# Create output directory
mkdir -p "$OUTPUT_DIR"
mkdir -p "$CONFIG_RESULTS_PATH"

# Build xcodebuild command
# Determine if project or workspace
if [[ "$CONFIG_PROJECT" == *.xcworkspace ]]; then
    XCODE_CMD="xcodebuild test -workspace \"$CONFIG_PROJECT_PATH\""
else
    XCODE_CMD="xcodebuild test -project \"$CONFIG_PROJECT_PATH\""
fi

XCODE_CMD="$XCODE_CMD -scheme \"$CONFIG_SCHEME\" -destination \"$CONFIG_DESTINATION\""

if [ "$TESTS_TO_RUN" == "all" ]; then
    XCODE_CMD="$XCODE_CMD -only-testing:$CONFIG_TEST_TARGET/$CONFIG_TEST_CLASS"
else
    # Build -only-testing flags for specific tests
    IFS=',' read -ra TEST_ARRAY <<< "$TESTS_TO_RUN"
    for test in "${TEST_ARRAY[@]}"; do
        XCODE_CMD="$XCODE_CMD -only-testing:$CONFIG_TEST_TARGET/$CONFIG_TEST_CLASS/$test"
    done
fi

XCODE_CMD="$XCODE_CMD -resultBundlePath \"$CONFIG_RESULTS_PATH/screenshots_$TIMESTAMP.xcresult\""
XCODE_CMD="$XCODE_CMD PROJECT_DIR=\"$PROJECT_DIR\""
XCODE_CMD="$XCODE_CMD SCREENSHOT_OUTPUT_DIR=\"$OUTPUT_DIR\""
XCODE_CMD="$XCODE_CMD GIT_COMMIT=\"$GIT_COMMIT\""

# Run tests
echo -e "${BLUE}Building and running screenshot tests...${NC}"
echo ""

# Check if xcpretty is available
if command -v xcpretty &> /dev/null; then
    eval "$XCODE_CMD" 2>&1 | xcpretty || true
else
    eval "$XCODE_CMD" || true
fi

echo ""

# Move screenshots to output directory (if they went to root Screenshots folder)
if [ -d "$CONFIG_OUTPUT_PATH" ]; then
    for png in "$CONFIG_OUTPUT_PATH"/*.png; do
        if [ -f "$png" ]; then
            mv "$png" "$OUTPUT_DIR/" 2>/dev/null || true
        fi
    done
fi

# Count screenshots
SCREENSHOT_COUNT=$(ls -1 "$OUTPUT_DIR"/*.png 2>/dev/null | wc -l | tr -d ' ')
CAPTURED_SCREENS=$(ls -1 "$OUTPUT_DIR"/*.png 2>/dev/null | xargs -I {} basename {} .png | jq -R -s 'split("\n") | map(select(length > 0))' 2>/dev/null || echo "[]")

# Generate metadata for this capture
METADATA_FILE="$OUTPUT_DIR/metadata.json"
cat > "$METADATA_FILE" << EOF
{
  "id": "$CAPTURE_ID",
  "commit": "$GIT_COMMIT",
  "commitFull": "$GIT_COMMIT_FULL",
  "branch": "$GIT_BRANCH",
  "timestamp": "$TIMESTAMP_ISO",
  "mode": "$MODE",
  "parent": $([ -n "$PARENT_ID" ] && echo "\"$PARENT_ID\"" || echo "null"),
  "capturedScreens": $CAPTURED_SCREENS,
  "screenCount": $SCREENSHOT_COUNT
}
EOF

# Add to index (skip if already exists with same ID)
EXISTING=$(jq -r ".captures[] | select(.id == \"$CAPTURE_ID\") | .id" "$INDEX_FILE" 2>/dev/null)
if [ -z "$EXISTING" ]; then
    add_to_index "$CAPTURE_ID" "$PARENT_ID" "$SCREENSHOT_COUNT"
    echo -e "${GREEN}Added to timeline: $CAPTURE_ID${NC}"
else
    echo -e "${YELLOW}Capture $CAPTURE_ID already in timeline (updated in place)${NC}"
fi

echo ""
echo -e "${GREEN}=== Screenshot Capture Complete ===${NC}"
echo ""
echo "Capture ID: $CAPTURE_ID"
echo "Screenshots saved to: $OUTPUT_DIR"
echo "Captured: $SCREENSHOT_COUNT screenshots"
echo ""

if [ -d "$OUTPUT_DIR" ]; then
    ls -la "$OUTPUT_DIR"/*.png 2>/dev/null | head -5 || echo "(no screenshots found)"
    if [ "$SCREENSHOT_COUNT" -gt 5 ]; then
        echo "... and $((SCREENSHOT_COUNT - 5)) more"
    fi
fi

# Auto-regenerate viewer
if [ -f "$SCRIPT_DIR/darwin-viewer" ]; then
    echo ""
    echo -e "${CYAN}Regenerating viewer...${NC}"
    "$SCRIPT_DIR/darwin-viewer" --generate-only 2>/dev/null
    if [ $? -eq 0 ]; then
        echo -e "${GREEN}✓ Viewer updated${NC}"

        # Auto-open viewer if configured
        if [ "$CONFIG_OPEN_VIEWER" = "true" ]; then
            VIEWER_PATH="$OUTPUT_DIR/viewer.html"
            if [ -f "$VIEWER_PATH" ]; then
                echo -e "${CYAN}Opening viewer...${NC}"
                open "$VIEWER_PATH" 2>/dev/null || true
            fi
        fi
    fi
fi

# Contextual next steps
echo ""
echo -e "${CYAN}What's next?${NC}"
if [ "$MODE" == "baseline" ]; then
    echo "  Your baseline is ready! Now you can:"
    echo "    1. Make changes to your app"
    echo "    2. Run: ${GREEN}darwin capture${NC}         # Smart capture changes"
    echo "    3. Run: ${GREEN}darwin viewer${NC}          # Open visual timeline"
    echo ""
    echo "  Pro tip: Add a git hook to auto-capture on commit:"
    echo "    ${GREEN}darwin hook install${NC}"
else
    CAPTURE_COUNT=$(jq '.captures | length' "$INDEX_FILE" 2>/dev/null || echo "0")
    if [ "$CAPTURE_COUNT" -gt 1 ]; then
        echo "  Compare changes:"
        echo "    ${GREEN}darwin diff${NC}                 # Compare to previous"
        echo "    ${GREEN}darwin diff --html${NC}          # HTML diff report"
        echo ""
        echo "  Visualize timeline:"
        echo "    ${GREEN}darwin viewer${NC}               # Open interactive viewer"
    else
        echo "  Continue developing and run ${GREEN}darwin capture${NC} after changes."
    fi
fi

echo ""
echo -e "${GREEN}🧬 Done${NC}"

# Send Slack notification (if configured)
send_slack_notification "success" "Captured $SCREENSHOT_COUNT screens"
