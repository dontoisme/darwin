{
  "version": "1.2",
  "description": "Darwin manifest - maps screens to source files for smart screenshot capture",

  "screens": {
    "01-home": {
      "name": "Home",
      "description": "Main home/landing screen",
      "test": "testScreenshot_01_Home",
      "sources": [
        "Sources/Views/HomeView.swift",
        "Sources/ViewModels/HomeViewModel.swift"
      ],
      "flows_to": [
        "02-settings",
        {
          "target": "03-profile",
          "element": "home_button_profile",
          "type": "navigation"
        }
      ]
    },

    "02-settings": {
      "name": "Settings",
      "description": "App settings screen",
      "test": "testScreenshot_02_Settings",
      "sources": [
        "Sources/Views/SettingsView.swift"
      ],
      "flows_to": [
        {
          "target": "05-detail-populated",
          "element": "settings_row_account",
          "type": "navigation"
        }
      ]
    },

    "03-profile": {
      "name": "Profile",
      "description": "User profile screen",
      "test": "testScreenshot_03_Profile",
      "sources": [
        "Sources/Views/ProfileView.swift",
        "Sources/ViewModels/ProfileViewModel.swift"
      ],
      "flows_to": [
        {
          "target": "04-login-sheet",
          "element": "profile_button_login",
          "type": "sheet"
        }
      ]
    },

    "04-login-sheet": {
      "name": "Login Sheet",
      "description": "Login modal sheet",
      "test": "testScreenshot_04_LoginSheet",
      "sources": [
        "Sources/Views/LoginView.swift"
      ],
      "flows_to": []
    },

    "05-detail-populated": {
      "name": "Detail (With Content)",
      "description": "Detail view with sample content",
      "test": "testScreenshot_05_DetailPopulated",
      "sources": [
        "Sources/Views/DetailView.swift",
        "Sources/ViewModels/DetailViewModel.swift"
      ],
      "flows_to": []
    }
  },

  "groups": {
    "main": {
      "name": "Main",
      "color": "#4CAF50",
      "screens": ["01-home", "02-settings", "03-profile"]
    },
    "auth": {
      "name": "Authentication",
      "color": "#2196F3",
      "screens": ["04-login-sheet"]
    },
    "content": {
      "name": "Content",
      "color": "#FF9800",
      "screens": ["05-detail-populated"]
    }
  },

  "_schema": {
    "_comment": "Schema documentation for Darwin manifest",
    "version": "Manifest version (1.2+ supports element-aware flows)",
    "screens": {
      "_comment": "Map of screen ID -> screen definition",
      "name": "Display name for the screen",
      "description": "Optional description",
      "test": "XCTest method name (must match exactly)",
      "sources": "Swift files that trigger recapture when changed",
      "flows_to": "Navigation targets - can be string (screen ID) or object with element info"
    },
    "flows_to_formats": {
      "string": "Just the target screen ID (backward compatible)",
      "object": {
        "target": "Target screen ID (required)",
        "element": "Accessibility identifier of tap target (optional)",
        "type": "Flow type: navigation | sheet | state | tab (optional, default: navigation)"
      }
    },
    "groups": "Optional screen groupings for map visualization"
  }
}
